$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Earth's 3rd Moon" @
         "\n<f1>Weather: <f0> Rainy" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other at uncomfortably close range with their high flying bases.  Each team must retrieve the other's flag and successfully bring it back to their base and touch it to their own flag to capture it.  Also, notice the objecive that each team can take control of at any time during the game.  The first team with 12 captures shall be the victor!" @
	 "\n<f1>Map By:<f4> Kennett Smith aka Goldberg";