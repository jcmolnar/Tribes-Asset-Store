$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Ultima Thule" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> are battling for control of five abandoned towers.  Each tower contains a switch; touch it to capture it for your team.  " @
         "In addition each base holds the enemy flag. Capture the enemy flag to gain 1 point for your team. The first team to reach 10 points wins the mission.";
