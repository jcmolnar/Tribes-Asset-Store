			deleteOnDestroy = "False";
			rotates = "True";
			collideable = "False";
			count = "1";
			locked = "0";
		};
	};
};
//--- export object end ---//
$teamScoreLimit = 6;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 3;
$cdPlayMode = 1;
