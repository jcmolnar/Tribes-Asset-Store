$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Halcyon II" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Dusk" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> having heavily fortified bases will battle it out again on the planet of Halcyon II. It's a long walk over to the other base so hitch a ride if you can." @
         "\n\n<f1>Designed by: <f0> Pokey" @
         "\n\n<f1>Special Thanks: <f0> Thanks for an awesome map editor tutorial Earthworm (http://www.seatac.net/earthworm/)! Your work is much appreciated!";
