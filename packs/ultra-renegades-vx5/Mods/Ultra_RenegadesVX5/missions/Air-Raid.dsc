$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0>Septa Scarabrae IV" @
         "\n<f1>Weather: <f0>Warm and a bit muggy. Rain has passed on last night." @
         "\n<f1>Time of Day: <f0>Midday" @ 
         "\n<f1># of Teams: <f0> 2" @  
         "\n\n<f1>Briefing :<f0>The <vServer::teamName0> and the <vServer::teamName1> are at it again.  This time they've taken it to the sky in an Air-Raid." @
	 "\nCapture the flag <f1>15 times<f4> to gain victory over the enemy." @

