$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Septa Scarabae IV" @
         "\n<f1>Weather: <f0> Foggy & Raining" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle one another at close quarters.  Each team must take the other's flag and successfully bring it back to their base, touching it to their own flag to capture.  The first team with <f1>15 points<f4> shall be the victor!" @

"\n\n<f1>Objective:<f0> Capture the objectives to gain an advantage over the other team in assisting your defense." @
"\nThe objective will earn your team <f1>1 point<f4>." @
"\n\n<f1>Map By: <f4>Psylocke - http://www.thexmen.net" @

"\n\n<f1>Version:<f0> 1.0" @

"\n<f1>UltraVX4MapPack: <f4>http://www.planetstarsiege.com/ultravx";