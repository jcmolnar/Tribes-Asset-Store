//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function GroupTrigger::onEnter(%this, %object)

{
	%playerArmor = Player::getArmor(%object);
	%energyLevel = GameBase::getEnergy(%object);
	if (getObjectType(%object) == "Player") %client = Player::getClient(%object);
	else return;
	if (Player::isDead(%object)) return;
	%team = GameBase::getTeam(%this);
	if(%this.num == "Main1")
	{
		%client = Player::getClient(%object);
		%armor = Player::getArmor(%object);
		if (%team == GameBase::getTeam(%object))
			messageall(0, Client::getName(%client) @ " got a little too close to his own team's Electric coils.~welf_fire.wav");
		else
			messageall(0, Client::getName(%client) @ " got a little too close to the " @ getTeamName(%team) @ "'s Electric coils.~welf_fire.wav");
		GameBase::applyDamage(%object, $ElectricityDamageType, %armor.maxDamage, GameBase::getPosition(%object), "0 0 0","0 0 0", %object);
	}
//Start of the Accelerator
	else if(%this.num == "go")
 	{
		if(%playerArmor == "darmor" || %playerArmor == "harmor" || %playerArmor == "jarmor")
		{
			// sets the speed and direction
			%velocityGO = 150;
			
			// this value adjusts the boost of the z axis for the accelerator
			%zVecGO = 65;
			
			// this takes the players current energy level and adds 10 units to it
			%boost = %energyLevel + 20;
			
			// creates vector from rotation  (rotation, length, zvalue(0))
			%jumpDir = Vector::getFromRot(GameBase::getRotation(%object),%velocityGO,%zVecGO);
			// give the player an energy boost!
			GameBase::setEnergy(%object, %boost);
	
			// give the player a speed boost!
			Player::applyImpulse(%object,%jumpDir);
		}
		else if(%playerArmor == "marmor" || %playerArmor == "mfemale" || %playerArmor == "aarmor" || %playerArmor == "afemale" || %playerArmor == "barmor" || %playerArmor == "bfemale" || %playerArmor == "earmor" || %playerArmor == "efemale" || %playerArmor == "dmarmor" || %playerArmor == "dmfemale")
		{
			// sets the speed and direction
			%velocityGO = 100;
			
			// this value adjusts the boost of the z axis for the accelerator
			%zVecGO = 50;

			// this takes the players current energy level and adds 20 units to it
			%boost = %energyLevel + 20;

			// creates vector from rotation  (rotation, length, zvalue(0))        
			%jumpDir = Vector::getFromRot(GameBase::getRotation(%object),%velocityGO,%zVecGO);
			// give the player and energy boost!
			GameBase::setEnergy(%object, %boost);
	
			// give the player a speed boost!
			Player::applyImpulse(%object,%jumpDir);
		}

		// if the player is in light armor...
		else if(%playerArmor == "larmor" || %playerArmor == "lfemale" || %playerArmor == "spyarmor" || %playerArmor == "spyfemale" || %playerArmor == "stimarmor" || %playerArmor == "stimfemale" || %playerArmor == "sarmor" || %playerArmor == "sfemale" || %playerArmor == "rarmor")
		{
			// sets the speed and direction
			%velocityGO = 69;

			// this value adjusts the boost of the z axis for the accelerator
			%zVecGO = 25;
			
			// this takes the players current energy level and adds 30 units to it
			%boost = %energyLevel + 30;
	
			// creates vector from rotation  (rotation, length, zvalue(0))       
			%jumpDir = Vector::getFromRot(GameBase::getRotation(%object),%velocityGO,%zVecGO);
			// give the player and energy boost!
			GameBase::setEnergy(%object, %boost);
	
			// give the player a speed boost!
			Player::applyImpulse(%object,%jumpDir);
		}

		else
		{
			Client::SendMessage(%client,0,"");
			Client::SendMessage(%client,1,"" @ %playerArmor @ " not recoginzed!~waccess_denied.wav");
			Client::SendMessage(%client,1,"Gates won't work for this armor class.");
		}
	}
// end of the Accelerator
}

$maphelp1 = "The Flags are stored under water in the Flag Pools...";
$maphelp2 = "Hold your breath and make the plunge.";
$maphelp3 = "Don't stay down too long, you'll drown.";
$maphelp4 = "Repair functions also provide extra oxygen.";
