};
//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$cdTrack = 3;
$cdPlayMode = 1;
//==============================================
//=== Here is what defines the map as a DM-Free For All map
//==============================================
$Game::missionType = "DM";	//=== can be any map type

noDeployables();	//===disables all deployables.
teamKillScore();  //===enables team scoring for kills

