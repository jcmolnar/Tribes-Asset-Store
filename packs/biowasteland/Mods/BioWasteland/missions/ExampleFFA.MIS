						position = "24.8875 -93.6514 166.705";
						rotation = "0 -0 -0.519983";
					};
				};
			};
		};
		instant TeamGroup "team4" {
			instant DropPointGroup "DropPoints" {
				instant SimGroup "Random" {
					instant Marker "Drop Point1" {
						dataBlock = "DropPointMarker";
						name = "";
						position = "49.2518 -75.4622 166.705";
						rotation = "0 -0 2.07995";
					};
				};
				instant SimGroup "Start" {
					instant Marker "Drop Point1" {
						dataBlock = "DropPointMarker";
						name = "";
						position = "47.5326 -72.5005 166.705";
						rotation = "0 -0 1.99995";
					};
				};
			};
		};
		instant TeamGroup "team5" {
			instant DropPointGroup "DropPoints" {
				instant SimGroup "Start" {
