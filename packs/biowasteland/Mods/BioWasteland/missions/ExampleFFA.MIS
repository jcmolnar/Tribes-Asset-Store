						dataBlock = "DropPointMarker";
						name = "";
						position = "28.3277 -73.6098 166.705";
						rotation = "0 -0 -2.63996";
					};
				};
				instant SimGroup "Random" {
					instant Marker "Drop Point1" {
						dataBlock = "DropPointMarker";
						name = "";
						position = "31.4272 -71.7447 166.705";
						rotation = "0 -0 -2.57996";
					};
				};
			};
		};
		instant TeamGroup "team6" {
			instant DropPointGroup "DropPoints" {
				instant SimGroup "Start" {
