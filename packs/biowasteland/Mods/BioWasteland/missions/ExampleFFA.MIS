						dataBlock = "DropPointMarker";
						name = "";
						position = "20.5627 -89.2072 166.705";
						rotation = "0 -0 -1.19994";
					};
				};
				instant SimGroup "Random" {
					instant Marker "Drop Point1" {
						dataBlock = "DropPointMarker";
						name = "";
						position = "19.1178 -85.8909 166.705";
						rotation = "0 -0 -1.13994";
					};
				};
			};
		};
	};
	instant SimGroup "ObserverDropPoints" {
		instant Marker "Drop Point1" {
			dataBlock = "DropPointMarker";
			name = "";
			position = "28.7704 -70.5087 178.092";
			rotation = "-0.898147 0 -3.12106";
		};
		instant Marker "Drop Point1" {
			dataBlock = "DropPointMarker";
			name = "";
			position = "37.4943 -89.8978 179.757";
			rotation = "-0.990141 0 0.347916";
		};
	};
	instant SimGroup "CutsomVolShapes" {
		instant InteriorShape "floatpad1" {
			fileName = "floatpad.dis";
			isContainer = "1";
			position = "1.66556 -50.7406 167.902";
			rotation = "0 0 0";
			lightParams = "0 ";
		};
		instant InteriorShape "watchtower1" {
			fileName = "watchtower.dis";
			isContainer = "1";
			position = "-25.9709 55.0092 224.206";
			rotation = "0 0 0";
			lightParams = "0 ";
		};
		instant InteriorShape "tblock1" {
			fileName = "tblock.dis";
			isContainer = "0";
			position = "0.789158 -57.8383 161.859";
			rotation = "0 0 0";
			lightParams = "0 ";
		};
		instant InteriorShape "sbunker1" {
			fileName = "sbunker.dis";
			isContainer = "1";
			position = "62.9983 -8.48848 164.628";
