//==============================================
//=== To make a Racing map...
//===
//=== 1. Use the Editor to add a SimGroup to the mission.
//===    This SimGroup will hold all the Legs, and should hold nothing else.
//=== 2. To this SimGroup, add as many SimGroups (at least one)as you
//===    want Legs to the course.  The Leg SimGroups will hold all the RaceTriggers,
//===    and should hold nothing else.
//=== 3. To the Leg SimGroups, add RaceTriggers in the order players should pass them.
//===
//=== Thats it.  Its that simple.
//===
//=== If your editor doesn't have RaceTriggers, use GroupTriggers to
//=== design your mission, then when its complete, rename the dataBlocks
//=== from GroupTrigger to RaceTrigger.
//===
//=== Players will respawn at the last trigger of the last completed leg.
//===
//=== Its recomended that triggers of any type not be bigger than 40 in any dimension.
//==============================================
	instant SimGroup "Race Course Folder" {
		instant SimGroup "Flying Leg" {
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-68.0455 279.411 150.222";
				rotation = "0 0 0";
				boundingBox = "-20 -2 -4 20 2 4";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-261.469 364.47 209.564";
				rotation = "0 -0 1.55993";
				boundingBox = "-20 -2 -4 20 2 4";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-427.899 419.189 249.65";
				rotation = "0 -0 0.699988";
				boundingBox = "-20 -2 -4 20 2 4";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-505.522 630.844 149.658";
				rotation = "0 -0 -2.61791e-06";
				boundingBox = "-25 -2 -4 25 2 4";
				isSphere = "True";
			};
		};
		instant SimGroup "Running Leg" {
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-520.672 779.9 120.75";
				rotation = "0 0 0";
				boundingBox = "-8 -1 -1 8 1 1";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-592.229 982.603 133.779";
				rotation = "0 -0 0.559991";
				boundingBox = "-20 -1 -3 20 1 3";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-676.259 1150.03 121.778";
				rotation = "0.137609 0.333717 0.316779";
				boundingBox = "-15 -1 -4 15 1 4";
				isSphere = "True";
			};
			instant Trigger "RaceTrigger1" {
				dataBlock = "RaceTrigger";
				name = "";
				position = "-959.453 1315.08 185.883";
				rotation = "0 -0 1.21995";
				boundingBox = "-4 -1 -2 4 1 2";
				isSphere = "True";
			};
		};
	};
};
//--- export object end ---//
exec(objectives);
$cdTrack = 3;
$cdPlayMode = 1;
//==============================================
//== The next line of script is not required, but its how many laps required to win.
//== Default is one.
//==============================================
$laps = 1;
//==============================================
//== The mission type can be any type!  So You can have racing Duels, Racing CTF, etc.
//==============================================
$Game::missionType = "CTF";


