//==============================================
//=== Map Example By Biohazard
//==============================================
//=== You need to scroll down and read my comments as they appear.
//=== Some of the most important comments are at the end, so keep looking.
//=== This assumes you already know how to use the Tribe's Map Editor.
//=== To learn the map editor, get my Map Making Tutorial Download.
//==============================================

//--- export object begin ---//
instant SimGroup "MissionGroup" {
	instant SimGroup "Volumes" {
		instant SimVolume "InterfaceVol" {
			fileName = "Interface.vol";
		};
		instant SimVolume "entities" {
			fileName = "Entities.vol";
		};
		instant SimVolume "tedFile" {
			fileName = "Broadside.ted";
		};
		instant SimVolume "human1DML" {
			fileName = "human1DML.vol";
		};
		instant SimVolume "lushWorld" {
			fileName = "lushWorld.vol";
		};
		instant SimVolume "lushTerrain" {
			fileName = "lushTerrain.vol";
		};
		instant SimVolume "lushDML" {
			fileName = "lushDML.vol";
		};
		instant SimVolume "savanaDML" {
			fileName = "savanaDML.vol";
		};
		instant SimVolume "MissionLighting" {
			fileName = "Broadside.vol";
		};
		instant SimVolume "Volume1" {
			fileName = "custom.vol";
		};
	};
	instant SimGroup "World" {
		instant SimPalette "palette" {
			fileName = "lush.day.ppl";
		};
	};
	instant SimGroup "Landscape" {
		instant Sky "Sky" {
			dmlName = "litesky.dml";
			skyColor = "0 0 0";
			hazeColor = "3.39562e+38 3.39562e+38 3.39562e+38";
			featurePosition = "0";
			size = "600";
			textures[0] = "0";
			textures[1] = "1";
			textures[2] = "2";
			textures[3] = "3";
			textures[4] = "4";
			textures[5] = "5";
			textures[6] = "6";
			textures[7] = "7";
			textures[8] = "8";
			textures[9] = "9";
			textures[10] = "10";
			textures[11] = "11";
			textures[12] = "12";
			textures[13] = "13";
			textures[14] = "14";
			textures[15] = "15";
			distance = "800";
		};
		instant SimTerrain "Terrain" {
			tedFileName = "Broadside.dtf";
			visibleDistance = "600";
			hazeDistance = "400";
			hazeVerticalMin = "1.16388e-08";
			hazeVerticalMax = "1.7414e-39";
			perspectiveDistance = "100";
			screenSize = "50";
			contGravity = "0 0 -20";
			contDrag = "0";
			contHeight = "10000";
			position = "-3072 -3072 0";
//==============================================
//=== Mess with rotation! This is how I make terrain overhead!
//=== Generally to rotate an object 90 degrees use 1.57 or 90 depending on object type
//=== Generally to rotate an object 180 degrees use 3.14 or 180 depending on object type
//==============================================
			rotation = "0 0 0";
		};
//==============================================
//=== center of the terrain is 0 0 0
//=== x and y set the lower left hand corner of the playable map
//=== w and h set the width and hight of the playable map (usually double x and y)
//=== This is how you can zoom in on a map to make it a smaller mission
//==============================================
		instant MissionCenterPos "MissionCenter" {
			x = "-100";
			y = "-100";
			w = "200";
			h = "200";
		};
	};
	instant SimGroup "Lights" {
		instant Planet "sunLight" {
			fileName = "lushdaysun.bmp";
			azimuth = "178.656";
			incidence = "49";
			castShadows = "True";
			useLensFlare = "True";
//==============================================
//=== This is how you make a dark map, or light map
//=== intensity numbers represent red blue yellow intensity
//=== set all three to zero and its a pitch black map
//=== set red to something and blue and yellow to zero and its a red map!
//==============================================
			intensity = "0.699959 0.699959 0.699959";
			ambient = "0.299963 0.299963 0.299963";
			size = "180";
			distance = "1200";
		};
	};
