	instant SimGroup "NormalTrigger" {
//==============================================
//=== This flag stand is just so your player can find the trigger
//==============================================
		instant StaticShape "Stand1" {
			dataBlock = "flagstand";
			name = "";
			position = "54.8978 -74.5636 166.701";
			rotation = "0 0 0";
			destroyable = "True";
			deleteOnDestroy = "False";
		};
		instant SimGroup "elevator4x4" {
//==============================================
//=== This elevator SimGroup is what the GroupTrigger can trigger
//==============================================
			instant SimPath "Path1" {
				isLooping = "False";
				isCompressed = "False";
				instant Marker "Marker1" {
					dataBlock = "PathMarker";
					name = "";
					position = "52.5715 -67.8022 166.795";
					rotation = "0 0 0";
				};
				instant Marker "Marker1" {
					dataBlock = "PathMarker";
					name = "";
					position = "52.5717 -67.8024 178.567";
					rotation = "0 0 0";
				};
			};
			instant Moveable "elevator_4x41" {
				dataBlock = "elevator4x4";
				name = "";
				position = "52.5715 -67.8022 166.795";
				rotation = "0 0 0";
				destroyable = "True";
				deleteOnDestroy = "False";
				waypoint = "top";
				delayTime = "123.61";
				Status = "up";
			};
//==============================================
//=== This is an example of a normal GroupTrigger which the editor can add to your map.
//=== This one does nothing special except what it was meant to do... trigger groups.
//=== In this case, it will trigger the elevator, since it is in the elevator's
//=== group, even if the player is not standing on the elevator.
//=== I've placed a flag stand with this trigger so you know where to stand and
//=== try this out.  You can open doors this way too.
//==============================================
			instant Trigger "GroupTrigger1" {
				dataBlock = "GroupTrigger";
				name = "";
				position = "54.7647 -74.7686 167.501";
				rotation = "0 0 0";
				boundingBox = "-1 -1 -1 1 1 1";
				isSphere = "True";
			};
		};
		instant StaticShape "solar1" {
			dataBlock = "SolarPanel";
			name = "";
			position = "57.1177 -71.3701 166.701";
			rotation = "0 0 0";
			destroyable = "True";
			deleteOnDestroy = "False";
		};
		instant StaticShape "InventoryStation1" {
			dataBlock = "InventoryStation";
			name = "";
			position = "28.0298 -94.2706 166.7";
			rotation = "0 -0 -2.67998";
			destroyable = "True";
			deleteOnDestroy = "False";
		};
	};
	instant SimGroup "TeleportGroup" {
//==============================================
//=== This is an example of a teleport trigger.  It's basically a normal
//=== GroupTrigger, but you need to add the last two lines of script
//=== to it yourself, since the editor doesn't do this.
//=== The in line tells the game something special could happen
//=== when the player is in the trigger.
//=== The num line tells it what special thing should happen.
//==============================================
		instant Trigger "GroupTrigger1" {
			dataBlock = "GroupTrigger";
			name = "TeleToInside";
			position = "20.8342 -79.4461 167.652";
			rotation = "0 0 0";
			boundingBox = "-1 -1 -1 1 1 1";
			isSphere = "True";
			in = "True";
			num = "Main1";
		};
//==============================================
//=== This is a simple MapMarker used to tell yourself where the teleport should
//=== send the player to.  Copy and paste its position into the teleport script
//=== found at the end of this file.
//==============================================
		instant Marker "Marker1" {
			dataBlock = "PathMarker";
			name = "TeleInSpawnPoint";
			position = "31.8752 -69.2295 161.974";
			rotation = "0 0 0";
		};
//==============================================
//=== The following electric beam tells the player where the teleport trigger
//=== is, because triggers are invisible in game play, but it's not neccessary.
//=== If you had nothing, the player would be surprised when he entered the
//=== invisible trigger and was teleported!
//==============================================
		instant StaticShape "ElectrBeam1" {
			dataBlock = "ElectricalBeam";
			name = "";
			position = "20.8343 -79.4462 166.701";
			rotation = "0 0 0";
			destroyable = "True";
			deleteOnDestroy = "False";
		};
	};
	instant SimGroup "GiveFistsGroup" {
//==============================================
//=== This is an example of a Fists trigger, which I use to give
//=== players fists for my boxing maps.  It's basically a normal
//=== GroupTrigger, but you need to add the last two lines of script
//=== to it yourself, since the editor doesn't do this.
//=== The in line tells the game something special could happen
//=== when the player is in the trigger.
//=== The num line tells it what special thing should happen.
//==============================================
		instant Trigger "GroupTrigger1" {
			dataBlock = "GroupTrigger";
			name = "GiveFistsTrigger";
			position = "34.647 -85.5 162.651";
			rotation = "0 -0 0.479992";
			boundingBox = "-1 -1 -1 1 1 1";
			isSphere = "True";
			in = "True";
			num = "Main2";
		};
//==============================================
//=== The following mainpad tells the player where the Fist trigger
//=== is, because triggers are invisible in game play, but it's not neccessary.
//=== If you had nothing, the player would be surprised when he entered the
//=== invisible trigger and was given fists!
//==============================================
		instant StaticShape "mainpad1" {
			dataBlock = "mainpad";
			name = "";
			position = "34.9468 -85.9419 161.701";
			rotation = "0 -0 -2.65994";
			destroyable = "True";
			deleteOnDestroy = "False";
		};
	};
	instant SimGroup "TrapTriggerGroup" {
		instant Trigger "GroupTrigger1" {
//==============================================
//=== This is an example of a Trap trigger.  It's basically a normal
//=== GroupTrigger, but you need to add the last two lines of script
//=== to it yourself, since the editor doesn't do this.
//=== The in line tells the game something special could happen
//=== when the player is in the trigger.
//=== The num line tells it what special thing should happen.
//==============================================
			dataBlock = "GroupTrigger";
			name = "TrapTrigger";
			position = "42.1456 -82.1924 162.592";
			rotation = "0 -0 0.459992";
			boundingBox = "-1 -1 -1 1 1 1";
			isSphere = "True";
			in = "True";
			num = "Main3";
		};
//==============================================
//=== The following LeechPack tells the player where the Trap trigger
//=== is, because triggers are invisible in game play, but it's not neccessary.
//=== If you had nothing, the player would be surprised when he entered the
//=== trap trigger and got hurt!
//==============================================
		instant Item "LeechPack1" {
			dataBlock = "LeechPack";
			name = "";
			position = "42.6488 -83.1468 164.362";
			rotation = "0 0 0";
			destroyable = "True";
			deleteOnDestroy = "False";
			rotates = "True";
			collideable = "False";
			count = "1";
		};
	};
};
//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 3;
$cdPlayMode = 1;

//==============================================
//  Additional map commands you can add...
//==============================================

noDeployables();	//=== disables all deployables.
teamKillScore();  //=== enables team scoring for kills
Lava();		//=== turns on lava damage for the terrain
indoorMap();	//=== disables items which could allow players to escape the indoor map

//==============================================
//=== Map Scripts
//==============================================
//=== No need for a map.cs file, just add your scripts
//=== to the end of a map.
//=== BE CAREFUL when writing new functions and such.
//=== NEVER redefine existing Tribes functions or Mod functions just for one map!
//=== Basically, you redefined the server even though you placed your script in a map.
//=== That function will remain redefined on the server even after the map is done!
//==============================================


//==============================================
//=== The following two lines disable the games fair-teams checker.
//=== Use this if you want or need the map to have uneven teams.
//=== BioWasteland will reset these two variables to default values
//=== at the end of every map, so its ok.  In general, however,
//=== DON'T re-define server variables with maps, because most don't reset
//=== when the map is done.
//==============================================
schedule("$Wasteland::FairCheck = \"2340\";", 10);
schedule("$Wasteland::FairEvens = \"2340\";", 10);


//==============================================
//=== This announces me as the maps maker.
//==============================================
schedule("Messageall(1, \"A map by Bïohazard!~wmale5.wcheer3.wav\");", 100);


//==============================================
//=== This script will disable the listed packs for all 8 teams
//==============================================
for(%i = -1; %i < 8 ; %i++)
{
	schedule("$TeamItemCount[%i]@\"Warppack\"]++;",10);
	schedule("$TeamItemCount[%i]@\"HolePack\"]++;",10);
}

//==============================================
//=== This script will disable the listed pack for only team 1
//==============================================
schedule("$TeamItemCount[1@\"MalicePack\"]=2;",10);


//==============================================
//=== This script will pre-deploy a jailStand for team 0.
//=== In this case it goes into the little bunker in the map.
//=== This way you can build a predetermined jail.
//=== Players are always released from jail above it, so plan for that.
//=== Test it by jailing the bot.
//==============================================
//team0 jail
%sensor = newObject("Jail Pad","StaticShape","jailStand",true);
CreatejailportSimSet();
addToSet("MissionCleanup/jailports", %sensor);
addToSet("MissionCleanup", %sensor);
GameBase::setTeam(%sensor,0);
GameBase::setPosition(%sensor,"62.8476 -9.79214 162.633");
Gamebase::setMapName(%sensor,%name);
%sensor.disabled = false;
schedule("$TeamItemCount[GameBase::getTeam("@%sensor@")@\"jailpack\"]++;",10);


//==============================================
//=== Here is where we define what GroupTriggers with the in and num lines do.
//=== You can make a GroupTrigger do anything you want it to.
//=== Be sure to use in and num variables, so you dont accidently affect the
//=== server's normal GroupTriggers.  Failure to do so will make the
//=== normal GroupTriggers for elevators and doors do erronous things.
//==============================================
function GroupTrigger::onEnter(%this, %object)
{
	%client = Player::getClient(%object);
	%player = Client::getOwnedObject(%client);
	if(%player == -1 || getObjectType(%player) != "Player" || Player::isDead(%player))
		return;
	if(%this.in)  //== A player has entered a trigger which does something special!
	{
		SHResetStats();
//==============================================
//=== Main1 is the teleport trigger, remember!
//=== So lets define the teleport drop point here.
//==============================================
		if(%this.num == "Main1")
		{
			GameBase::setPosition(%client, "31.8752 -69.2295 161.974");
			//== a sound effect during teleportation is not necessary,
			//== but lets use one the shield hit one.
			Client::SendMessage(%client,0,"~wshieldhit.wav");
			return;  //=== end the trigger-script routine, we are done here
		}
//==============================================
//=== If we had other teleport triggers meant to go somewhere else,
//=== just add more like this...
//==============================================
		if(%this.num == "Main?")
		{
			GameBase::setPosition(%client, "X Y Z");
			Client::SendMessage(%client,0,"~wshieldhit.wav");
			return;
		}
//==============================================
//=== Main2 was our Fists trigger, remember!
//=== So lets strip the player of weapons and give him fists instead.
//==============================================
		if(%this.num == "Main2")
		{
			%armor = Player::getArmor(%client);
			if (%armor == "aarmor"){
				Client::SendMessage(%client,1,"Oh, sorry.  No Stealth Armor.  Being reset to Goliath.~wturretoff1.wav");
				Player::setArmor(%client, barmor);
			}
			if (%armor == "afemale"){
				Client::SendMessage(%client,1,"Oh, sorry.  No Stealth Armor.  Being reset to Goliath.~wturretoff1.wav");
				Player::setArmor(%client, bfemale);
			}
			if (%armor == "larmor"){
				Client::SendMessage(%client,1,"Oh, sorry.  No Assassin Armor.  Being reset to Spy.~wturretoff1.wav");
				Player::setArmor(%client, spyarmor);
			}
			if (%armor == "lfemale"){
				Client::SendMessage(%client,1,"Oh, sorry.  No Assassin Armor.  Being reset to Spy.~wturretoff1.wav");
				Player::setArmor(%client, spyfemale);
			}
			%numweapon = Player::getItemClassCount(%client,"Weapon");
			%max = getNumItems(); 
			for (%i = 0; %i < %max; %i = %i + 1)
			{ 
				%item = getItemData(%i);
				%count = Player::getItemCount(%client,%item); 
				if(%count && %item != "Fists") Player::setItemCount(%client,%item,0); 
			}
			Player::setItemCount(%object, Fists, 1);
			%item = Player::getMountedItem(%client,$WeaponSlot);
			if (%item != "Fists") Player::MountItem(%object,fists,0);
			Client::SendMessage(%client,3,"Let's box!~wmale2.wtaunt4");
			return;
		}
//==============================================
//=== Main3 was our Trap trigger, remember!
//=== So lets hit the player with a poison-tipped dart and rumble the place a bit
//=== like what happens in TombRaider.
//==============================================
		else if(%this.num == "Main3")
		{
			%pos = GameBase::getPosition(%object);
			playSound(Ricochet3, %pos);
			Client::SendMessage(%client,2,"You've been hit with a poison-tipped dart.");
			Renegades_startBlind(%client, %player, 4);
			StartRumble();  //== start the functions defined below!
		}
      }
}

//==============================================
//=== What follows are new functions this map needs.
//==============================================

function MakeRumbleDrop(%grenadetype) {
	%randnumber = floor(getRandom() * 15);
	if(%randnumber == 1) {
		%grenadeposition = "33.8143 -87.4725 160.7";
	} else if(%randnumber == 2) {
		%grenadeposition = "37.7127 -86.9476 160.7";
	} else if(%randnumber == 3) {
		%grenadeposition = "41.3976 -84.4067 160.7";
	} else if(%randnumber == 4) {
		%grenadeposition = "43.4967 -81.5174 160.7";
	} else if(%randnumber == 5) {
		%grenadeposition = "41.4615 -78.198 165.7";
	} else if(%randnumber == 6) {
		%grenadeposition = "37.2726 -77.972 165.7";
	} else if(%randnumber == 7) {
		%grenadeposition = "33.974 -78.3721 165.7";
	} else if(%randnumber == 8) {
		%grenadeposition = "30.9092 -76.5875 165.7";
	} else if(%randnumber == 9) {
		%grenadeposition = "35.0864 -74.0514 165.7";
	} else if(%randnumber == 10) {
		%grenadeposition = "37.8737 -74.0854 165.7";
	} else if(%randnumber == 11) {
		%grenadeposition = "36.123 -70.9585 165.7";
	} else if(%randnumber == 12) {
		%grenadeposition = "31.0287 -70.9632 165.7";
	} else if(%randnumber == 13) {
		%grenadeposition = "27.8454 -72.2086 160.7";
	} else if(%randnumber == 14) {
		%grenadeposition = "33.0475 -70.6419 160.7";
	} else if(%randnumber == 15) {
		%grenadeposition = "36.9192 -69.3852 160.7";
	} else {
		%grenadeposition = "31.0094 -81.1305 165.7";
	}
	%object = newObject("","Mine",%grenadetype);
	addToSet("MissionCleanup", %object);
	GameBase::SetPosition(%object, %grenadeposition);
}

