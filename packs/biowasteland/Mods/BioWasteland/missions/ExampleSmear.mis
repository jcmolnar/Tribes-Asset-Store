$cdTrack = 5;
$cdPlayMode = 1;

//==============================================
//=== This is what makes the mission a smear mission...
//==============================================
exec("smear.cs");

//==============================================
//=== These following lines are needed to prevent the fair teams checker
//=== from evening teams during this mission...
//==============================================
schedule("$Wasteland::FairCheck = \"2340\";", 10);
schedule("$Wasteland::FairEvens = \"2340\";", 10);


schedule("Messageall(1, \"A map by Bïohazard!~wmale5.wcheer3.wav\");", 80);