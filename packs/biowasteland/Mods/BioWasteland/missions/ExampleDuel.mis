//==============================================
//=== Map Example By Biohazard
//==============================================
//=== You need to scroll down and read my comments as they appear.
//=== Some of the most important comments are at the end, so keep looking.
//=== This assumes you already know how to use the Tribe's Map Editor.
//=== To learn the map editor, get my Map Making Tutorial Download.


//==============================================
//== Dueling maps are pretty easy.  You just need 8 teams (team0 thru Team 7).
//== That's pretty much it.  Then, at the end of this file, you'll see the final step...
//== Well, go look!
//==============================================

//--- export object begin ---//
instant SimGroup "MissionGroup" {
	instant SimGroup "Volumes" {
		instant SimVolume "InterfaceVol" {
			fileName = "Interface.vol";
		};
		instant SimVolume "entities" {
			fileName = "Entities.vol";
		};
		instant SimVolume "World" {
			fileName = "iceWorld.vol";
		};
		instant SimVolume "WorldTerrain" {
			fileName = "iceTerrain.vol";
		};
		instant SimVolume "iceDML" {
			fileName = "iceDML.vol";
		};
		instant SimVolume "savanaDML" {
			fileName = "savanaDML.vol";
		};
		instant SimVolume "human1DML" {
			fileName = "human1DML.vol";
		};
		instant SimVolume "TedFile" {
			fileName = "4_Commander_TargetLaser.ted";
			locked = "1";
		};
		instant SimVolume "MissionLighting" {
			fileName = "4_commander_targetlaser.vol";
			locked = "1";
		};
	};
	instant SimGroup "World" {
		instant SimPalette "Palette" {
			fileName = "ice.night.ppl";
		};
		instant MissionCenterPos "MissionCenter" {
			x = "-600";
			y = "-250";
			w = "800";
			h = "700";
		};
	};
	instant SimGroup "Landscape" {
		instant Sky "Sky" {
			dmlName = "icenitesky.dml";
			skyColor = "0 0 0";
			hazeColor = "0 0 0";
			featurePosition = "0";
			size = "700";
			textures[0] = "0";
			textures[1] = "1";
			textures[2] = "2";
			textures[3] = "3";
			textures[4] = "4";
			textures[5] = "5";
			textures[6] = "6";
			textures[7] = "7";
			textures[8] = "8";
			textures[9] = "9";
			textures[10] = "10";
			textures[11] = "11";
			textures[12] = "12";
			textures[13] = "13";
			textures[14] = "14";
			textures[15] = "15";
			distance = "13000";
		};
		instant Planet "Sun" {
			fileName = "";
			azimuth = "60";
			incidence = "61";
			castShadows = "True";
			useLensFlare = "False";
			intensity = "0.699911 0.699911 0.699911";
			ambient = "0.299912 0.299912 0.299912";
			size = "100";
			distance = "1000";
		};
		instant SimTerrain "Terrain" {
			tedFileName = "4_Commander_TargetLaser.dtf";
			visibleDistance = "1000";
			hazeDistance = "275";
			hazeVerticalMin = "1.04918e-38";
			hazeVerticalMax = "7.57081e-38";
			perspectiveDistance = "100";
			screenSize = "80";
			contGravity = "0 0 -20";
			contDrag = "0";
			contHeight = "15000";
			position = "-3072 -3072 0";
			rotation = "0 0 0";
		};
		instant StarField "stars1" {
			inFrontOfSky = "False";
			colors[0] = "1 1 1";
			colors[1] = "0.5 0.5 0.5";
			colors[2] = "0.5 0.5 0.5";
		};
		instant Snowfall "Snow1" {
			intensity = "1";
			wind = "0 0 -35";
			suspendRendering = "False";
			rain = "False";
		};
	};
	instant SimGroup "Lights";
//==============================================
//== Each Duel takes place with both players on the same team, so...
//== You only need one team drop point set in each duel arena.
