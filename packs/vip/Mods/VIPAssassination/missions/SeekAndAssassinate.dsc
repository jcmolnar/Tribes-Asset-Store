$MDESC::Text = "<s3><f1>Mission Type: <f0> VIP Assassination\n<f1>Planet: <f0> Tyr's Cradle\n<f1>Weather: <f0> Snow and ice\n<f1>Time of Day: <f0> Night\n<f1># of Teams: <f0>2\n<f1>Max Bases: <f0> 4/13\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> tribes have both committed small units to this planet in hopes of claiming control of it.  Now these two units have come face to face and their Commanders have discovered they hold a long standing grudge!  Neither is willing to leave this planet in the hands of his arch rival!  A bloody battle awaits and one Commander will lie dead before it is over.  \n\nProtect your Commander while attempting to kill your enemy's Commander.  The first to kill the enemy's Commander shall be the victor!";
$MDESC::Type = "VIP";
