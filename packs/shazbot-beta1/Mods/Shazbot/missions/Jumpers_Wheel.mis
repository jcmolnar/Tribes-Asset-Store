//Start ^^Plasmatic^^ MAGIC. ziptiezmail@netscape.net//
// Thanks Plas for making this so I could use it in my maps!//

function aa::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	GameBase::playSound(%this, SoundActivateMotionSensor, 0);
	//messageAll(0, "~wshieldhit.wav");
	//messageAll(1, Client::getName(%c) @ " Got a jolt from Zeus");
	gamebase::setrechargerate(client::getownedobject(%c), 65535);
	} 	
function bb::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	gamebase::setautorepairrate(client::getownedobject(%c), 65535);
	//messageAll(0, "~wC_BuySell.wav");
	GameBase::playSound(%this, SoundActivateMotionSensor, 0);
	//messageAll(1, Client::getName(%c) @ " became godlike");

	
	} 

function boing::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	
	GameBase::playSound(%this, SoundFireMortar, 0);
	%velocity = 1500;
	%zVec = 150;
	 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
	} 

function boing2::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	
	GameBase::playSound(%this, SoundFireMortar, 0);
	%velocity = 25;
	%zVec = 1000;
	 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
	} 

