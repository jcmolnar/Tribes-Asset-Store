//--- export object end ---//
$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");
messageAll(1, "OHMSS Briefing:");	
messageAll(0, "This is a matter of international security 007. Consider the military personel expendable.");
messageAll(0, "Bond nobody needs a dead hero.");
messageAll(0, "Underground in Siberia James? Some of us dont get further than the Northern Line.");
messageAll(0, "Its cold in Siberia James. Make sure you wrap up warm and take care to protect your extremities.");
messageAll(3, "...");
}

// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}