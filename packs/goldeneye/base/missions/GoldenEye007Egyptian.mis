//--- export object end ---//
$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");	
messageAll(1, "OHMSS Briefing:");
messageAll(0, "This is sinister 007. Weve received a message from someone claiming to be Baron Samedi the voodoo sorcerer you crossed swords with back in Haiti.");
messageAll(0, "Obviously its a trap but as a double 0 agent you know that goes with the territory.");
messageAll(0, "Do you do voodoo James?");
messageAll(3, "...");
}


// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}
