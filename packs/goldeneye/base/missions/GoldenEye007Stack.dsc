$MDESC::Type = "GoldenEye007";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other inside a St. Petersburg library. " @
         "\n\n<f1>OHMSS Briefing: " @
         "\n\n<f0>This is a matter of international security 007. Consider the military personel expendable." @
         "\n\n<f0>Bond nobody needs a dead hero." @
         "\n\n<f0>Underground in Siberia James? Some of us dont get further than the Northern Line." @
         "\n\n<f2>Its cold in Siberia James. Make sure you wrap up warm and take care to protect your extremities.";
