$MDESC::Type = "GoldenEye007";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other inside a Russian Complex. " @
         "\n\n<f1>OHMSS Briefing: " @
         "\n\n<f0>That girl again James? " @
         "\n\n<f0>You know James shes not the only woman who can operate a computer." @
         "\n\n<f0>Dont mess your trousers up James. " @
         "\n\n<f2>As soon as you get back. IF you get back. Youre getting a performance review." ;
