$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{	
messageAll(3, "...");
messageAll(1, "OHMSS Briefing:");
messageAll(0, "Honestly 007 ol chap I am not sure how you ended up here it seems perfectly dark. ");
messageAll(0, "Take care 007 and be certain to use the bomb defuser correctly.");
messageAll(0, "Whatever part in whatever building you seem to be in is very high up.");
messageAll(0, "Hardly a lovers leap James. Be careful though I hate to think of you falling for anyone else.");
messageAll(3, "...");
}

// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}