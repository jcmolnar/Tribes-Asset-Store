$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");
messageAll(1, "OHMSS Briefing:");	
messageAll(0, "Xenia Onatopp may be lurking nearby. They say she has thighs of steel James. Just be sure to stay out of their grasp.");
messageAll(0, "I dont think shes worth the trouble James. Perhaps you should be looking closer to home for a more reliable woman?");
messageAll(0, "Be careful and remember you are licensed to kill.");
messageAll(3, "...");
}

// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}