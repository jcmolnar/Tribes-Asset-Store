//--- export object end ---//
$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");	
messageAll(1, "OHMSS Briefing:");
messageAll(0, "Honestly James sometimes I think you damage your equipment on purpose.");
messageAll(0, "I hope you can defend your performance because there isnt a lawyer in the land whod take on the case.");
messageAll(0, "There are no women or casinos for a thousand miles 007 so even you will be able to concentrate on this mission.");
messageAll(3, "...");
}

// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}