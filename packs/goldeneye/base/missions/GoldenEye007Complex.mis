//--- export object end ---//
$teamScoreLimit = 5;
exec("server/game/ctf");
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{	
messageAll(3, "...");
messageAll(1, "OHMSS Briefing:");
messageAll(0, "That girl again James? You know James shes not the only woman who can operate a computer. ");
messageAll(0, "Dont mess your trousers up James.");
messageAll(0, "As soon as you get back. IF you get back. Youre getting a performance review.");
messageAll(3, "...");
}


// add the object
if($TestShape[Name] != "")
{
   focusServer();
   
   // create the objects and add to the missiongroup
   %vol = newObject(shapeVol, SimVolume, $TestShape[Name] @ ".div", true);
   addToSet(MissionGroup, %vol);
   
   %shape = newObject(testShape, InteriorShape, $TestShape[Name] @ ".dis");
   addToSet(MissionGroup, %shape);
   
   // move the shape
   GameBase::setPosition(%shape, $TestShape[XPos] @ " " @
      $TestShape[YPos] @ " " @ $TestShape[ZPos]);

}