$MDESC::Type = "GoldenEye007";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other inside a Temple in the Valley of Kings. " @
         "\n\n<f1>OHMSS Briefing: " @
         "\n\n<f0>Keep a cool head and youll get out alive. " @
         "\n\n<f0>Remember to treat the timed explosives with respect. You know what happened to 004 in Beirut." @
         "\n\n<f0>Remember the saying James? Never go back." @
         "\n\n<f0>This must go smoothly 007. If the press get a sniff of this well all have egg on our faces." @
         "\n\n<f2>Failure is not an option Bond.";
