$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "Open Call";
$cdTrack = 6;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Tatooine.");
messageAll(0, "The Rebel Alliance have made a Jawa Sandcrawler their new mobile base on the planet Tatooine");
messageAll(0, "but the Galactic Empire have now taken over Jabba's Palace!");
messageAll(0, "Well, if there's a bright center to the universe, you're on the planet that it's farthest from.");
messageAll(3, "...");
}
 
