$MDESC::Type = "Star Wars";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The Galactic Empire and the Rebel Alliance battle each other on Hoth, a remote, icy planet in the galaxy's Outer Rim Territories." @
         "\n\n<f1>Jedi Archives: " @
         "\n\n<f0>Hoth. The sixth planet in the star system of the same name. " @
         "\n\n<f0>Local attractions." @
         "\n\n<f0>Home to a species of towering predators known as wampas." @
         "\n\n<f2>Somewhere on this icy planet is the rebels Echo Base..";
