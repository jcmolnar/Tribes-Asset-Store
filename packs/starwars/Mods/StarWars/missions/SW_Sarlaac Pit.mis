//--- export object end ---//
$teamScoreLimit = 5;
exec(pit);
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);
schedule("Laserz2();", 10);   //Objective Laser
schedule("Laserz2();", 11);   //Objective Laser2
schedule("Laserz2();", 12);   //Objective Laser3

function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Sarlacc Pit.");
messageAll(0, "The Galactic Empire and the Rebel Alliance battle each other over a Sarlaac Pit in the Dune Sea of the desert planet Tatooine.");
messageAll(0, "Victims of the almighty Sarlacc, His Excellency hopes that you will die honorably. In its belly, you will find a new definition of pain and suffering, as you are slowly digested over a thousand years...");
messageAll(3, "...");
}

AI::spawn("Mark", $AI::defaultArmorType, "0 0 0", "0 0 0", "Mark", "male2");

$bot = AI::getId("Mark");

function Laserz2()
{
%startPos0 ="128.581 117.839 106.0";
%laseVec0 ="0.3 -1.0 1"; // 0 0 1
%newTrans0 ="0 0 0 "@%laseVec0@" 0 0 0 "@%startPos0; // 0 0 0
Projectile::spawnProjectile("SeekerLaser", %newTrans0, $bot, "0 0 0", 1.0); 
}