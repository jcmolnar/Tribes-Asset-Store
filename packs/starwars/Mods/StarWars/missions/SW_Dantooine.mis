$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 3;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Dantooine.");
messageAll(0, "The Galactic Empire and the Rebel Alliance have taken structure on the planet Dantooine.");
messageAll(0, "Dantooine? That's in the middle of nowhere. That's the whole point. Where else could the rebels hide?");
messageAll(3, "...");
}