$MDESC::Type = "Star Wars";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The Galactic Empire and the Rebel Alliance battle each other on Hoth." @
         "\n\n<f1>Jedi Archives: Sith Knight " @
         "\n\n<f0>The Rebel Alliance has been resupplying it's fleet from an unknown location, until now!" @
         "\n\n<f0>An Imperial Probe Droid has identified the Rebel Space Station orbiting the planet Hoth.." @
         "\n\n<f0>With the approach of an Imperial Light Cruiser this can only mean one thing, WAR!!!" @
         "\n\n<f2>Sith Knight was the title given to a former Sith apprentice who had completed his or her training with a Sith Master or another Sith Knight.";
