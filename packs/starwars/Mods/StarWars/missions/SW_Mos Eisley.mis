function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Mos Eisley.");
messageAll(0, "The Galactic Empire and the Rebel Alliance battle each other on Mos Eisley, a spaceport on the desert planet of Tatooine.");
messageAll(0, "You will never find a more wretched hive of scum and villainy. We must be cautious...");
messageAll(3, "...");
}