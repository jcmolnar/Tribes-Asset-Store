function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Sith Knight.");
messageAll(0, "The Galactic Empire and the Rebel Alliance battle each other on Hoth.");
messageAll(0, "Sith Knight was the title given to a former Sith apprentice who had completed his or her training with a Sith Master or another Sith Knight.");
messageAll(3, "...");
}

