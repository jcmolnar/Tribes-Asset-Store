function Laserz2()
{
%startPos0 ="-305.305 532.233 259.5"; // 260.613
%laseVec0 ="0 0 1"; // 0 0 1
%newTrans0 ="0 0 0 "@%laseVec0@" 0 0 0 "@%startPos0; // 0 0 0
Projectile::spawnProjectile("SeekerLaser", %newTrans0, $bot, "0 0 0", 1.0); 
}