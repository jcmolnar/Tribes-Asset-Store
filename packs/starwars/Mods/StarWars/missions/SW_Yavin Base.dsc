$MDESC::Type = "Star Wars";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The Galactic Empire and the Rebel Alliance battle each other on Yavin located in the Gordian Reach in the Outer Rim Territories." @
         "\n\n<f1>Jedi Archives: Yavin" @
         "\n\n<f0>The system was the namesake of the Yavin Code, which was determined at the Yavin Convention." @
         "\n\n<f0>The Galactic Empire has located the Rebel base at Yavin and deployed ground troops for an assault on the base." @
         "\n\n<f0>A Light class Imperial Cruiser hovers near the ground for Imperial troops to stage their attack." @
         "\n\n<f2>The first Death Star was destroyed in a major battle over Yavin 4, a moon located within the system.";