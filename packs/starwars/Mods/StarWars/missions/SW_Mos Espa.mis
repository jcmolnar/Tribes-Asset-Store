$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Credits();", 15);

function Credits()
{
messageAll(3, "...");
messageAll(1, "Jedi Archives:");
messageAll(0, "Mos Espa.");
messageAll(0, "The Galactic Empire and the Rebel Alliance battle each other on Mos Espa, a spaceport settlement located on the desert world of Tatooine.");
messageAll(0, "Somewhere on this planet the city center lies within a crator.");
messageAll(3, "...");
}