$MDESC::Type = "Star Wars";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Location:<f0> The Galactic Empire and the Rebel Alliance battle each other at Mos Espa, a spaceport settlement located on the desert world of Tatooine." @
         "\n\n<f1>Jedi Archives: " @
         "\n\n<f0>Mos Espa. " @
         "\n\n<f0>Local attractions." @
         "\n\n<f0>Mos Espa Grand Arena. Boonta Eve Classic Podrace. The city center is located within a crater." @
         "\n\n<f2>Mos Espa was also home to a number of slaves, including Anakin Skywalker and his mother, Shmi.";