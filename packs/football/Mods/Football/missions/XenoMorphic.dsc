$MDESC::Type = "GSL Football";
$MDESC::Text = "<s3><f1>Mission Type: <f0>GSL Football" @
         "\n<f1>Stadium: <f0> Floating Fortress on XenoMorph" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
	 "\n<f1>Special Thanks: <f0>Lei,Lackey, Eeprom, Spike, my DOT brothas and rest of you for giving me helpful suggestions of this map." @
         "\n<f1>Visit DOTs at: <f0>http://nescio-online.com/dots/intro.html"@
	 "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other on the planet XenoMorph. Home of blizzards and ice storms, these teams wage battle on a floating fortress for rights over this planet. Instead of blasting each other with Spinfusors, they battle on the gridiron with a game of football!" @
         "\n\n<jc><f1>**<f0>Map engineered and designed by:<f1>**\n<f2>Xeno/Fei(DOTs)\n\n\n<f0>Completed: 6/25/01";

