function GroupTrigger::onEnter(%this, %object) {
	if (getObjectType(%object) != "Player") return;
	%client = Player::getClient(%object);
	%team = Client::getTeam(%client);
	if(%team == 0) %oteam = 1; else %oteam = 0;
	%rnd = floor(getRandom() * 3) + 1;
	Client::sendMessage(%client, 0, "~wteleport2.wav");
	GameBase::setPosition(%object, $tele[%oteam, %rnd]);
}

%group = nameToId("MissionGroup\\Teams\\team0\\MotherShip\\MissileSystems\\System1\\Com");
%count = Group::objectCount(%group);
