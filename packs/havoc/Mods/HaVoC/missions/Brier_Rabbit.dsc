$MDESC::Type = "Kill the Rabbit";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Kill the Rabbit" @
         "\n<f1>Planet: <f0> Mongo's Orchard" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> are at it again. This time the <vServer::teamName0> just may have the Rabbit right where they want him. Suit up and go, this is gonna get Harey. As for our furry little friend: Good Luck!";
