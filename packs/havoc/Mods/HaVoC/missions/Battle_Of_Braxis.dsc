$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Zeta Hercules XI" @
         "\n<f1>Weather: <f0> Foggy" @
         "\n<f1>Time of Day: <f0> Unknown" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> Terran versus Protoss, on the icy world of Braxis, secret location of the coveted Uraj crystal. The Protoss have a small pylon outpost and the Terrans have a duel habitation capsule. Map made by: {DF}Ecliptici";
