$MDESC::Type = "Multiple Team";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Xaos" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 4" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0>,  <vServer::teamName1>, <vServer::teamName2> and <vServer::teamName3> are stationed dangerously high above the earth with just a sandy grave below.  This battle was difficult enough with two teams, but the addition of the two extra teams makes this an all out war.  Bring back any of the three opposing flags to your base to score.  8 flag caps takes the game." @
	 "\n\n<f1>Built By:<f4> Goldberg"@
	 "\n\n<f1>Troubleshooting/Tweaking:<f4> XTERM"@
	 "\n\n<f1>Get your custom built map @ www.planetstarseige.com/extreme";