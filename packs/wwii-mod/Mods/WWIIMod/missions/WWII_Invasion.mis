$country[0] = "British";
$country[1] = "German";
$teamScoreLimit = 125;
$WWII::TeamPoints[Allied] = 50;
$WWII::TeamPoints[Axis] = 600;
exec(WWII_Conquest);
exec(objectives);
exec(WWII_InvasionMap);
exec(WWII_GermanAI);
for(%cl = Client::getFirst(); %cl != -1; %cl = Client::getNext(%cl)) gameBase::setTeam(%cl, 0);
exec(WWII_AlliedAI);
//Invasion::AISetup();
$Game::missionType = "Objective";
$cdTrack = 2;
$cdPlayMode = 1;
Conquest::SetObjectives();
Invasion::AISetup();
$WWII::Weather = clear;
schedule("Invasion::BeginMissionScript();", 10);