$MDESC::Type = "CTF Mixed";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Big Frontier" @
         "\n<f1>Weather: <f0> Patchy Clouds, slight fog" @
         "\n<f1>Time of Day: <f0> Lunch" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other to prove who is stronger by capturing each others flags. The name of this map derived from it's true creater Grizzly Adams." @
         "\n\n<f1>Map built by:<f0> EEPROM (Mappers Extreme)" @
