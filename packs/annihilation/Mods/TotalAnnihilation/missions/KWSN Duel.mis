		schedule("bottomprint(" @ %playerClient @ ", \"<jc><f1>Do not attack players unless dueling or in a ffa arena.\", 4);", 6);
		schedule("Client::sendMessage(" @ %playerClient @ ", 1,\"~wshell_click.wav\");", 9);
		schedule("bottomprint(" @ %playerClient @ ", \"<jc><f1>If you do, you will be kicked.\", 4);", 9);
		schedule("Client::sendMessage(" @ %playerClient @ ", 1,\"~wshell_click.wav\");", 12);
		schedule("bottomprint(" @ %playerClient @ ", \"<jc><f1>Push the switches to make bots appear.\", 4);", 12);
		schedule("Client::sendMessage(" @ %playerClient @ ", 1,\"~wshell_click.wav\");", 15);
