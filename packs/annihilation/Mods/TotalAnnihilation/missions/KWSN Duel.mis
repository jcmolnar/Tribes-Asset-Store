function GroupTrigger::onEnter(%this, %object)
{
%client = Player::getClient(%object);
	if(%this.num == "Main1"){
	Client::SendMessage(%client,3,"You Have Entered Gohan's Ground Duel; Dueling only!~wturretoff4.wav");
      %positionIn = "-289.065 -227.172 176.807";
      %positionOut = "";
   }
      else if(%this.num == "Main2"){
      Client::SendMessage(%client,3,"Returning Back to Base; No Killing!~wturretoff4.wav");
      %positionIn = "-340.95 -169.49 3176.75";
      %positionOut = "";
   }
   else if(%this.num == "Main3"){
	Client::SendMessage(%client,3,"You Have Entered Gohan's Air Duel; Dueling only!~wturretoff4.wav");
      %positionIn = "-480.685 62.5556 4072.76";
      %positionOut = "";
   }
   else if(%this.num == "Main4"){
	Client::SendMessage(%client,3,"You Have Entered Gohan's Indoor Duel; Dueling only!~wturretoff4.wav");
      %positionIn = "-373.322 -71.3752 2576.08";
      %positionOut = "";
   }   
   else if(%this.num == "Main5"){
	Client::SendMessage(%client,3,"You Have Entered Gohan's Vehical Duel; Dueling only!~wturretoff4.wav");
      %positionIn = "-398.653 330.356 69.6811";
      %positionOut = "";
   }
   else if(%this.num == "Main6"){
	Client::SendMessage(%client,3,"You Have Entered Gohan's Indoor FFA; Dueling only!~wturretoff4.wav");
      %positionIn = "50.3155 -186.247 -210.059";
      %positionOut = "";
   }   
	else if(%this.num == "Main7"){
	Client::SendMessage(%client,3, " You Have Entered The Neutral Zone Figting is prohibited if broken u will b kicked!~wturretoff4.wav");
      %positionIn = "-322.569 -158.467 3176.93";
      %positionOut = "";
   }
      	else if(%this.num == "Main8"){
      	Client::SendMessage(%client,3,"You Have Entered Gohan's Bots Practice; Practicing only!~wturretoff4.wav");
      %positionIn = "36.1699 -177.206 1178.39";
      %positionOut = "";
   }


	if(%this.in){
         GameBase::setPosition(%client, %positionIn);
      }
      	else if(%this.out){
         GameBase::setPosition(%client, %positionOut);
        }
}

function AI::wieldWeapons(%aiName)
{
	%aiId = AI::getId(%aiName);
	
   if(Game::missionType == "DM")
   {	
      dbecho(2, "giving DM weapon select...");
      Player::setItemCount(%aiId, blaster, 1);
   }
   else
   {
      dbecho(2, "giving normal weapon select...");
	   Player::setItemCount(%aiId, Vulcan, 1);
	   Player::setItemCount(%aiId, VulcanAmmo, 1000);
   }
   
   Player::mountItem(%aiId, Vulcan, 0);
   AI::SetVar(%aiName, triggerPct, 1.0 );
   AI::setVar(%aiName, iq, 50 );
   AI::setVar(%aiName, attackMode, 1);
   AI::setAutomaticTargets( %aiName );
}
	
   function TowerSwitch::onCollision(%this, %object) {
   if(GameBase::getMapName(%this) == "Switch2") {
  createAI( Dummy1 , "MissionGroup\\AI\\RunBot", armorfAngel, Dummy );
  createAI( Dummy2 , "MissionGroup\\AI\\RunBot2", armorfAngel, Dummy );
  createAI( Dummy3 , "MissionGroup\\AI\\RunBot3", armorfAngel, Dummy );
  AI::wieldWeapons(Dummy1);
  AI::wieldWeapons(Dummy2);
  AI::wieldWeapons(Dummy3);
}
  if(GameBase::getMapName(%this) == "Switch3") {
  createAI( Dummy4 , "MissionGroup\\AI\\FlyBot", armorfAngel, Dummy );
} 
  if(GameBase::getMapName(%this) == "Switch4") {
  createAI( Dummy5 , "MissionGroup\\AI\\FlyBot1", armorfAngel, Dummy );
}
  if(GameBase::getMapName(%this) == "Switch5") {
  createAI( Dummy6 , "MissionGroup\\AI\\FlyBot2", armorfAngel, Dummy );
}
if(GameBase::getMapName(%this) == "Need Help Touch Me?")
	{
		%playerClient = Player::getClient(%object);

		schedule("Client::sendMessage(" @ %playerClient @ ", 1,\"~wsensor_deploy.wav\");", 0);
