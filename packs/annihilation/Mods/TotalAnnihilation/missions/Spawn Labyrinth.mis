schedule("Spawn();", 10);
schedule("Spawn2();", 20);


function Spawn()
{		
messageAll(3, "Annihilation Spawn CTF ||There are NO stations|| ~wmine_act.wav");	
messageAll(1, "Protect your flag and capture the enemy flag.");
bottomprintall("<f1><jc>Annihilation Spawn CTF ||There are NO stations|| \n <f0><jc> Protect your flag and capture the enemy flag.",  25);
schedule("Spawn();", 90);		
}

function Spawn2()
{		
bottomprintall("<f1><jc>Annihilation Spawn CTF ||There are NO stations|| \n <f0><jc> Protect your flag and capture the enemy flag.",  25);
schedule("Spawn2();", 90);	
}

deleteVariables("spinning*");	// Walls cannot be spun if they are already spinning, so clear this variable array when the mission loads.

//	If you see your team's logo, you're heading home.  If you see the enemy's logo, you're on the attack.
function AllyWall(%this)
{
	%rot = getWord(GameBase::getRotation(%this), 2);
	GameBase::setTeam(%this, %rot < -1.5707963267948966192313216916398 || 1.5707963267948966192313216916398 <= %rot);
}

// Each time this function is called, it rotates the selected wall 10 degrees in the specified direction.
function TurnWall(%this, %wise)
{
	%cen = Object::getName(%this);
	%rot = getWord(GameBase::getRotation(%this), 2) + (0.17453292519943295769236907684886 * %wise);
	GameBase::setPosition(%this, Vector::add(%cen, Vector::getFromRot("0 0 "@ %rot - 1.5707963267948966192313216916398, 16, 0)));
	GameBase::setRotation(%this, "0 0 "@ %rot);
	AllyWall(%this);
}

// Checks if the selected wall can be turned, or if it is obstructed.
function PickWall(%this)
{
	if(getObjectType(%this) == "InteriorShape" && !$spinning[%this] && !$ME::loaded)
	{
		%set = newObject($SimPlayerObjectType | $ItemObjectType | $StaticObjectType | $MineObjectType | $VehicleObjectType, SimSet);
		if(containerBoxFillSet(%set, Object::getName(%set), Object::getName(%this), 64, 64, 22, 11) < 1)
		{
			$spinning[%this] = true;
			%wise = getWord("-1 1", floor(getRandom() * 2));
			for(%num = 0; %num < 9; %num++)
				schedule("TurnWall("@ %this @", "@ %wise @");", %num / 10);
			schedule("deleteVariables(\"spinning"@ %this @"\");", 1);
		}
		deleteObject(%set);
	}
}

// Recursively reschedules itself, selecting 1 wall at random each second to be spun.
function LiveMaze(%this)
{
	PickWall(Group::getObject(%this, floor(getRandom() * (Group::objectCount(%this) - 1))));
	schedule("if($MissionName == \"Spawn Labyrinth\") LiveMaze("@ %this @");", 1);
}

// Preps the maze, ensuring all walls display the appropriate logos, and initiates the recursive scheduler.
%maze = nameToId("MissionGroup/Walls");
Group::iterateRecursive(%maze, AllyWall);
LiveMaze(%maze);
