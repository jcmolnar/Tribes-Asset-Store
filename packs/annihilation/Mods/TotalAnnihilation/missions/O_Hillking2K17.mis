			Player::setItemCount(%clientId, EnergyPack, 1);
			if(Player::getMountedItem(%pl,$backpackSlot) != EnergyPack)
				Player::useItem(%pl,EnergyPack);
			Legendz::useItem(%pl,DiscLauncherBase);
		}
		if(%clientId.DuelArmor == "TitanSpawn")
