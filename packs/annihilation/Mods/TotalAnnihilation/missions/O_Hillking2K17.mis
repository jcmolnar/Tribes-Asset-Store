	}
	else if($LegendzLT::Active == true) //New LT code -DaJ4ck3L
	{	
		if($LegendzLT::SpawnType == "AnniSpawn") //New LT toggle -DaJ4ck3L
		{
			Player::setItemCount(%clientId, iarmorWarrior, 1);	
