		{
			//Player::setItemCount(%clientId, iarmorLightArmor, 1);	//Removed since this isn't an actual item -DaJ4ck3L
			Player::setItemCount(%clientId, DiscLauncherBase, 1);
			Player::setItemCount(%clientId, ChaingunBase, 1);
