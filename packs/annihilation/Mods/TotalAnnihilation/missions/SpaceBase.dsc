$MDESC::Type = "CTF Mixed";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> NecroBones' Planet (high orbit)" @
         "\n<f1>Weather: <f0> Night" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Author: <f0> Ed T. Toton III, aka [ADP]Bones" @
         "\n<f1>Homepage: <f0> http://www.necrobones.com/" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> " @
         "teams battle against each other inside a floating space " @
         "station. Each team's side of the base can be claimed " @
         "as a capturable objective, so don't let the bad guys in! Also, " @
         "at the beginning of the battle, none of the security systems are " @
         "on alert, so you'll need to claim your own base before your defenses " @
         "will kick in. " @
         "\n\n<f1>Version:<f0> 1.0 (11/10/2000)";

