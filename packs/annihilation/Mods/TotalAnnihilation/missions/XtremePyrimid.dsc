$MDESC::Type = "CTF Mixed";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Quaznar X" @
         "\n<f1>Weather: <f0> Xtremely Hazy" @
         "\n<f1>Time of Day: <f0> Early Morning" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> batte it out in and around this Xtreme Pyramid. The first to score 8 points is the one who gains control. To do this you must capture the others flag and bring it back to your own and/or hold the central base. Good luck!!" @
	 "\n\n<f1>Map By:<f4> Lisa W.  (XGN LadyShar) Pick up all the Xtreme Gaming map packs at www.xtremegaming.net";