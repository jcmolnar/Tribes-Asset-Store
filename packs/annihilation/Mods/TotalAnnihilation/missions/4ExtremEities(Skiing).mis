		}
	}
	//if(%killerId.inDuel)
	//	Duel::Finish(%killerId, %playerId); //just need the dead guy -DaJ4ck3L
	if(%playerId.inArenaWin && $Arena::Winners)
	{
		if(%killerId == %playerId)
			ArenaWin::Finish(%killerId,false);
		else
			ArenaWin::Finish(%killerId,%playerId);
	}
	if(%playerId.inDuel)
