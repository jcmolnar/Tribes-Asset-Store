function NODIE::onDamage()
{
return;
}		

function GHOSTTRIG::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {
	%player = Player::getClient(%object);
	%client = Player::getClient(%object);
	%targetId = GameBase::getOwnerClient(%player);
    %omega = Client::getOwnedObject(%Targetid);	
	%name1 = Client::getName(%player);
	%client.briefing = 0;
	
	Client::sendMessage(Player::getClient(%object),2, "~wfemale1.wwatchsh.wav");
	schedule("briefing::On("@ %Client @");", 0.1); 
	schedule("briefing::Off("@ %Client @");", 10); 
	Schedule("MessageAll(0, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 0.5);
	Schedule("MessageAll(1, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 1);
	Schedule("MessageAll(2, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 1.5);
	Schedule("MessageAll(3, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 2);
	Schedule("MessageAll(0, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 2.5);
	Schedule("MessageAll(1, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 3);
	Schedule("MessageAll(2, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 3.5);
	Schedule("MessageAll(3, \""@%name1@" is fucking sexy! ~wWeapon5.wav\");", 4);
	TribalArmor(%player);
	Player::setItemCount(%player,TBlastCannon,1);
	Player::setItemCount(%player,TBlastCannonAmmo,70);
	Player::mountItem(%player, TBlastCannon, 0);
	GameBase::repairDamage(%player,0.5);
    }
}

function Teleporting::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {
	%client = Player::getClient(%object);
	Teleporting(%client);
    }
}

function briefing::On(%player)
{
	%client = Player::getClient(%player);
	
	schedule("briefing::On("@ %player @");", 0.1); 
		if(%client.briefing != 1)
		{
	centerprint(%client, "<jc><f2>Welcome to Ghost's secret pad.\n You have been given Tribal Armor and a Tank Blast Cannon for your current armor!\nUse the teleport beam to return to the fight.\n\n<bHJ_Icon_Green.bmp>", 3);
		}
}

function briefing::Off(%player)
{
%client = Player::getClient(%player);

centerprint(%client, "", 1);
%client.briefing = 1;
}


function TribalArmor(%player) 									
{ 
	schedule("dsword("@ %player @");", 0.15); 
	schedule("cphoenix("@ %player @");", 0.30); 
	schedule("base("@ %player @");", 0.45);
	schedule("swolf("@ %player @");", 0.60);  
	schedule("TribalArmor("@ %player @");", 0.60); 
}

function dsword(%player) 
{ 
Client::setSkin(%player,dsword);
}
function cphoenix(%player) 
{ 
Client::setSkin(%player,cphoenix);
}
function base(%player) 
{ 
Client::setSkin(%player,base);
}
function swolf(%player) 
{ 
Client::setSkin(%player,swolf);
}

													
// This code has been placed here by Annihilation mod Map editor,							
// to make teleporters created with the Annihilation map editor work.						
// For more information, go to http://www.annihilation.info							
// Code will not interfere with other mods, or base mod.								
															
// Annihilation Teleporter											
// copyright July, 2002 Steve Madden aka Plasmatic								
															
// Annihilation teleporters feature possible multiple random drop points, 					
// visible or invisible tele entry points,									
// and painless integration into the mission editor.								
															
// www.annihilation.info												
// ziptiezmail@netscape.net											
// -Plasmatic													
															
//========================= Beginning Teleport Code.. -plasmatic						
$UsingAnnTeleCS = true;												
															
//function modified to work with Annihilation, yet still compatable with base, and other mods.			
function GroupTrigger::onEnter(%this,%object)									
{														
	%type = getObjectType(%object);											
	if(%type == "Player" || %type == "Vehicle") {								
		if(%this.TeleTrigger == true)										
		{													
			// Teleporters created with Annihilation mod have a TeleTrigger field				
			// for the object in the .mis file -plasmatic							
			TeleTrigger::onTrigEnter(%this, %object);							
		}													
		else													
		{													
			%group = getGroup(%this); 									
 			%count = Group::objectCount(%group);							
 			for (%i = 0; %i < %count; %i++) 							
 				GameBase::virtual(Group::getObject(%group,%i),"onTrigEnter",%object,%this);	
 		}												
	}														
}														
															
//searches group for drop points, If more than one, picks random. -plasmatic					
function TeleTrigger::onTrigEnter(%this,%object)									
{														
															
	%type = getObjectType(%object);											
	if(%type == "Player" || %type == "Vehicle" || %type == "Flier")	
		if(Player::isAIControlled(%object))					
	{														
		%client = Player::getclient(%object);									
		if(GameBase::getControlClient(%object) != %client) %client = GameBase::getControlClient(%object);	
		if(Client::getTeam(%client) != GameBase::getTeam(%this) && GameBase::getTeam(%this) != -1) return;	
		%group = getGroup(%this);										
 		%count = Group::objectCount(%group);								
 		for(%i = 0; %i < %count; %i++)									
 			{ 											
 			%data = GameBase::getDataName(Group::getObject(%group,%i));				
 			if(%data == DropPointMarker) 								
 				{										
 				%DropCount++;									
 				%droppos = Group::getObject(%group,%i);						
 				%teleset = nameToID("MissionCleanup/TeleportSet"@%this);			
				if(%teleset == -1)									
				{											
					%group = newObject("TeleportSet"@%this, SimSet);				
					addToSet(MissionCleanup, %group);						
				}											
 				addToSet("MissionCleanup/TeleportSet"@%this, %droppos);			
 				}										
 			}											
 														
	// pick a random tele point within the set -plasmatic								
 			%spawnIdx = floor(getRandom() * (%DropCount - 0.1));					
			%group = nameToID("MissionCleanup/TeleportSet"@%this);					
 			%newpos = Group::getObject(%group,%spawnIdx);						
 			%message = %newpos.message;	//new for 2.2						
 		if(GameBase::GetPosition(%newpos) != "0 0 0")							
 			{											
 			GameBase::playSound(%object, ForceFieldOpen, 0);					
			GameBase::playSound(%this, ForceFieldOpen, 0);							
 	// added message field for custom messages, change in the mission list -Plasmatic			
 		if(%message != "")										
 			Client::sendMessage(%client, 0, %message);						
 		else												
				Client::sendMessage(%client, 0, "You have been teleported.~wshieldhit.wav");		
			GameBase::SetPosition(%object, GameBase::GetPosition(%newpos));					
			%Trot = GameBase::getRotation(%newpos); 							
			GameBase::setRotation(%object,%Trot);								
			GameBase::startFadeIn(%object);									
 		schedule("GameBase::playSound("@%object@", ForceFieldOpen, 0);",0.25);												
 			} 											
 		else echo("!! WARNING !! No matching teleport drop point in group!!");				
	}														
}														
//========================= Ending Teleport Code.. -plasmatic 																
															
