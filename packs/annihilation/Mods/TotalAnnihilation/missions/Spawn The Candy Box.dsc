$MDESC::Type = "CTF Spawn";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Some Place Green" @
         "\n<f1>Weather: <f0> Pretty Darn Clear" @
         "\n<f1>Time of Day: <f0> Midday *enclosed area*" @ 
         "\n<f1># of Teams: <f0> 4" @
         "\n\n<f1>Briefing: <f0> <vServer::teamName0>, <vServer::teamName1>, <vServer::teamName2> and last but not least <vServer::teamName3> are screwing around in 'The Candy Box'! Its basically a giant arena with four flags and four teams. Twenty flag captures in total and you win the title to the Candy Box. But in order to be the best you must have control of the 'The Candy Box' too, basically means you get your name written all over the place in the box. In order to have control you have to defend the 'Candy Box Switch'! A bit of an ego thing, but hey its still a point ahead of your rivals." @
         "\n\n<f1>Designed by: <f0> bosshog and FunGuns" @
         "\n\n<f1>Contact: <f0> cline@mediaone.net and iline@mediaone.net";