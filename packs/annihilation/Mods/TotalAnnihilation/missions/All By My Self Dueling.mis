function ai::AnniWeaponChangethree(%aiName)
{
   %aiId = AI::getId(%aiName);
   %curTarget = ai::getTarget( %aiName );

   if(%curTarget == -1)
   {
   return;
   }

   %targLoc = GameBase::getPosition(Client::getOwnedObject(%curTarget));
   %aiLoc = GameBase::getPosition(Client::getOwnedObject(%aiId));
   %targetDist = Vector::getDistance(%aiLoc, %targLoc);
   if(%targetDist > 25)
   {
   	Player::mountItem(%aiId, Vulcan, 0);
      AI::SetVar(%aiName, triggerPct, 1.0 );
   }   
   else
   {
      if(Player::isJetting(%curTarget))
      {	
         Player::mountItem(%aiId,  Vulcan, 0);
         AI::SetVar(%aiName, triggerPct, 1.0 );
      }
      else
      {
         Player::mountItem(%aiId, Vulcan, 0);  
         AI::SetVar(%aiName, triggerPct, 0.05 );
      }   
   }
}


function flagstand::onCollision(%this, %object)
{
  %client = Player::getclient(%object);
  createAI( Battlebot1 , "MissionGroup\\AI\\SPHYNX", armorTank, "SPHINX" );
  createAI( Battlebot2 , "MissionGroup\\AI\\SPHYNX2", armorTank, "SPHINX2" );
  createAI( Battlebot3 , "MissionGroup\\AI\\SPHYNX3", armorTank, "SPHINX3" );
  AI::wieldWeapons(Battlebot1);
  AI::wieldWeaponstwo(Battlebot2);
  AI::wieldWeaponsthree(Battlebot3);
}