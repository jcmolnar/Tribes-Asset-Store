//Render lines to show AI Graph
$AI::testGraph = 0;
function AI::GraphOn(){
   if( $AI::testGraph == 0 ){
   	$AI::testGraph = newObject( "graphRender", AI::GraphPathRender );
      Anni::Echo("Graph render on");
   }
   else{
      Anni::Echo("Graph render ALREADY on");
   }
}
function AI::GraphOff(){
   if( $AI::testGraph != 0 ){
   	deleteObject( $AI::testGraph );
      $AI::testGraph = 0;
   	Anni::Echo("Graph render off");
   }
   else{
      Anni::Echo("Graph render ALREADY off");
   }
}


function AI::testingCommander()
{
   %clientId = "2049";
   AI::helper("jettkiller", harmor, %clientId);
   %aiId = "2050";
   GameBase::setTeam(%aiId, 0);
   AI::callWithId(%aiId, Player::setItemCount, Mortar, 1);
	AI::callWithId(%aiId, Player::setItemCount, MortarAmmo, 10000);
   AI::callWithId(%aiId, Player::mountItem, mortar, 0);
   AI::DirectiveTargetLaser( %aiId, %clientId );
}

function ForceField::onCollision(%this, %object)
{
	%client = Player::getclient(%object);
        if(%this.num == "Main1")
        {
            Client::SendMessage(%client,6,"SPROING!~wteleport2.wav");
	    Item::setvelocity(%object,0);
	    Player::ApplyImpulse(%object, "780 -780 740");
        }
	%client = Player::getclient(%object);
        if(%this.num == "Main2")
        {
            Client::SendMessage(%client,6,"SPROING!~wteleport2.wav");
	    Item::setvelocity(%object,0);
	    Player::ApplyImpulse(%object, "780 780 740");
        }
	%client = Player::getclient(%object);
        if(%this.num == "Main3")
        {
            Client::SendMessage(%client,6,"SPROING!~wteleport2.wav");
	    Item::setvelocity(%object,0);
	    Player::ApplyImpulse(%object, "-780  780 740");
        }
	%client = Player::getclient(%object);
        if(%this.num == "Main4")
        {
            Client::SendMessage(%client,6,"SPROING!~wteleport2.wav");
	    Item::setvelocity(%object,0);
	    Player::ApplyImpulse(%object, "-780 -780 740");
        }
}

function AI::wieldWeapons(%aiName)
{
   %aiId = AI::getId(%aiName);
   Player::setItemCount(%aiId, Railgun, 1);
   Player::setItemCount(%aiId, RailAmmo, 10000);
   %rate = Player::getSensorSupression(%aiId) + 5;
   Player::setSensorSupression(%aiId, %rate);
   Player::mountItem(%aiId, EnergyPack, 1);
   AI::SetVar(%aiName, triggerPct, 0.03 );
   AI::setVar(%aiName, iq, 100 );
   AI::setVar(%aiName, attackMode, 1);
   AI::setAutomaticTargets( %aiName );
   ai::callbackPeriodic(%aiName, 3, ai::AnniWeaponChange);
}

function ai::AnniWeaponChange(%aiName)
{
   %aiId = AI::getId(%aiName);
   %curTarget = ai::getTarget( %aiName );

   if(%curTarget == -1)
   {
   return;
   }

   %targLoc = GameBase::getPosition(Client::getOwnedObject(%curTarget));
   %aiLoc = GameBase::getPosition(Client::getOwnedObject(%aiId));
   %targetDist = Vector::getDistance(%aiLoc, %targLoc);
   if(%targetDist > 25)
   {
   	Player::mountItem(%aiId, Railgun, 0);
      AI::SetVar(%aiName, triggerPct, 1.0 );
   }   
   else
   {
      if(Player::isJetting(%curTarget))
      {	
         Player::mountItem(%aiId,  Railgun, 0);
         AI::SetVar(%aiName, triggerPct, 1.0 );
      }
      else
      {
         Player::mountItem(%aiId, Railgun, 0);  
         AI::SetVar(%aiName, triggerPct, 0.05 );
      }   
   }
}

function AI::wieldWeaponstwo(%aiName)
{
   %aiId = AI::getId(%aiName);
   Player::setItemCount(%aiId, TRocketLauncher, 1);
   Player::setItemCount(%aiId, TRocketLauncherAmmo, 10000);
   %rate = Player::getSensorSupression(%aiId) + 5;
   Player::setSensorSupression(%aiId, %rate);
   Player::mountItem(%aiId, EnergyPack, 1);
   AI::SetVar(%aiName, triggerPct, 0.03 );
   AI::setVar(%aiName, iq, 100 );
   AI::setVar(%aiName, attackMode, 1);
   AI::setAutomaticTargets( %aiName );
   ai::callbackPeriodic(%aiName, 3, ai::AnniWeaponChangetwo);
}

function ai::AnniWeaponChangetwo(%aiName)
{
   %aiId = AI::getId(%aiName);
   %curTarget = ai::getTarget( %aiName );

   if(%curTarget == -1)
   {
   return;
   }

   %targLoc = GameBase::getPosition(Client::getOwnedObject(%curTarget));
   %aiLoc = GameBase::getPosition(Client::getOwnedObject(%aiId));
   %targetDist = Vector::getDistance(%aiLoc, %targLoc);
   if(%targetDist > 25)
   {
   	Player::mountItem(%aiId, TRocketLauncher, 0);
      AI::SetVar(%aiName, triggerPct, 1.0 );
   }   
   else
   {
      if(Player::isJetting(%curTarget))
      {	
         Player::mountItem(%aiId,  TRocketLauncher, 0);
         AI::SetVar(%aiName, triggerPct, 1.0 );
      }
      else
      {
         Player::mountItem(%aiId, TRocketLauncher, 0);  
         AI::SetVar(%aiName, triggerPct, 0.05 );
      }   
   }
}

function AI::wieldWeaponsthree(%aiName)
