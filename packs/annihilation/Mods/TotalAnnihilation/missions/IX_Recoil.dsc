$MDESC::Type = "CTF Mixed";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture The Flag" @
         "\n<f1>Planet		: <f0> Giddi II" @
         "\n<f1>Weather	: <f0> Enclosed Arena" @
         "\n<f1>Teams		: <f0> 2" @
	 "\n<f1>Author 	: <f0> *IX*Led Mirage" @
	 "\n<f1>Version	: <f0> 1.1 March-04-1999" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> tribes battle in this enclosed arena for the most flag captures. The key in this map is the power generators as each flag room has a forcefield and is heavily guarded by turrets. Also controling the lower level will gain you an extra point.";
