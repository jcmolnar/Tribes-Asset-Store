				if(Player::getMountedItem(%pl,$backpackSlot) != EnergyPack)
					Player::useItem(%pl,EnergyPack);
				Legendz::useItem(%pl,DiscLauncher);
				if(%clientId.isLegendz)
					MountWings(%clientId);
			}
			
