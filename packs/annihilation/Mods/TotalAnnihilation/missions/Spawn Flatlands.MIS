		Player::setItemCount(%clientId, PlasmaAmmo, 30);	  
		Player::setItemCount(%clientId, ShotgunShells, 30);
		Player::setItemCount(%clientId, thumperammo, 30);
		   
		Player::setItemCount(%clientId, RepairKit, 1);
		Player::setItemCount(%clientId, Beacon, 5);
		Player::setItemCount(%clientId, Grenade, 8);	   
		Player::setItemCount(%clientId, MineAmmo, 3);
		   	   
		Player::setItemCount(%clientId, EnergyPack, 1);
		if(Player::getMountedItem(%pl,$backpackSlot) != EnergyPack)
			Player::useItem(%pl,EnergyPack);	   
		Legendz::useItem(%pl,DiscLauncher);
	}
}

schedule("Spawn();", 10);
schedule("Spawn2();", 20);


function Spawn()
{		
messageAll(3, "Annihilation Spawn CTF ||There are NO stations|| ~wmine_act.wav");	
messageAll(1, "Protect your flag and capture the enemy flag.");
bottomprintall("<f1><jc>Annihilation Spawn CTF ||There are NO stations|| \n <f0><jc> Protect your flag and capture the enemy flag.",  25);
schedule("Spawn();", 90);		
}

function Spawn2()
{		
bottomprintall("<f1><jc>Annihilation Spawn CTF ||There are NO stations|| \n <f0><jc> Protect your flag and capture the enemy flag.",  25);
schedule("Spawn2();", 90);	
}