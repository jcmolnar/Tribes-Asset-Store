//Render lines to show AI Graph
$AI::testGraph = 0;
function AI::GraphOn(){
   if( $AI::testGraph == 0 ){
   	$AI::testGraph = newObject( "graphRender", AI::GraphPathRender );
      Anni::Echo("Graph render on");
   }
   else{
      Anni::Echo("Graph render ALREADY on");
   }
}
function AI::GraphOff(){
   if( $AI::testGraph != 0 ){
   	deleteObject( $AI::testGraph );
      $AI::testGraph = 0;
   	Anni::Echo("Graph render off");
   }
   else{
      Anni::Echo("Graph render ALREADY off");
   }
}


