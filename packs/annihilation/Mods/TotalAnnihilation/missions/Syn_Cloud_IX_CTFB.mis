$teamScoreLimit = 10;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 8;
$cdPlayMode = 1;
$Spoonbot::AutoSpawn = True;
schedule("Credits();", 10); 	//Dost thou read?

function Credits()
{		
// Gets called after 15 minutes of gameplay.
messageAll(3, "-=-=-=-=-=-=-=Map by Synsilliusarian=-=-=-=-=-=-=-");
messageAll(3, "~wfemale1.wdoh.wav");
}

// From Plasmatic's map JiveTurkey
// Kill trigger

function BlackHole::onContact(%this, %object)
{
	BlackHoleDamage(%object);
}

function BlackHoleDamage( %object)
{
	%obj=getObjectType (%object);
	if (%obj!="Player" && %obj!="Flier" || Player::isDead(%object))return;
	else{	player::setDamageFlash (%object, 0.3);
		%client=gameBase::getControlClient (%object);
		gameBase::setDamageLevel (%object, gameBase::getDamageLevel (%object)+(gameBase::getDataName(%object).maxDamage/5));
		client::sendMessage (%client, 1, "Dark Matter damage detected ~wAccess_Denied.wav");

	if(%obj=="Player" && Player::isDead(%object)){
		%name = Client::getName(%client); 
//		Messageall(0, %name @" found a black hole"); 
		echo(0, %name @" found a black hole"); 
 		playNextAnim(%object); 
		echo( %name @" found a black hole"); 
		return;
	}
	if(%obj="Flier" && gameBase::getDamageLevel (%object) > gameBase::getDataName(%object).maxDamage) return;
	}
	schedule("BlackHoleDamage(" @ %object @ ");", 2);	
}