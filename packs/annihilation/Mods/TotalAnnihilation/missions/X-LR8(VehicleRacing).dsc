$MDESC::Type = "Ski Maps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Racer" @
         "\n<f1>Planet: <f0> Septa Scarabae IV" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 1" @
         "\n\n<f1>Briefing:<f0> The racing track on Septa Scarabae IV is opened! This long track is filled with steep mountains and tunnels. You have to complete 8 rounds with a vehicle and keep your opponents from doing the same! If you get killed, you lose a lap!" @
         "\n\n<f1>Map by: <f2>Nathan Sweet aka [HvC]NaTeDoGG\n<f1>              creator of the HaVoC mod.\n              http://havoc.sirris.com";
