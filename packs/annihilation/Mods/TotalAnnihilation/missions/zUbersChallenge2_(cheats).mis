function Credits()
{		
messageAll(3, "Map by :UberWear:");
messageAll(3, "This is the cheat version of the map.");
messageAll(3, "You can vote to enable builder mode to change armors.");
messageAll(3, "Use this to practice for the real challenge.");
messageAll(3, "~wfemale1.wdoh.wav");
}



