//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 6;
$cdPlayMode = 1;

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	if(%this.num == "Main1"){
		%position = "0 -30 215";
		GameBase::setPosition(%client, %position);
		%jumpDir = Vector::getFromRot("1.047 0 3.1416", 1100, 0);
		Player::applyImpulse(%object,%jumpDir);
		%pos = GameBase::getPosition(%object);
		playSound (SoundFireSeeking, %pos);
		Client::SendMessage(%client,0,"Matter Accelerator Activated");
	} else if(%this.num == "Main2") {
		%position = "0 -894 214";
		GameBase::setPosition(%client, %position);
		%jumpDir = Vector::getFromRot("1.047 0 0", 1100, 0);
		Player::applyImpulse(%object,%jumpDir); 
		GameBase::playSound(%object,bigExplosion1,0);
		Client::SendMessage(%client,0,"Catapult Activated");
	}
}
