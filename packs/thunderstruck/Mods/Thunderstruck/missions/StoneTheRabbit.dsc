$MDESC::Type = "Kill the Rabbit";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Kill the Rabbit" @
         "\n<f1>Planet: <f0> Septa Scarabae IV" @
         "\n<f1>Weather: <f0> Foggy & Raining" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 1" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> again chase the <vServer::teamName1> with the flag.  But this <vServer::teamName1> has teeth!  May the best <vServer::teamName1> win, because you can't score enough points if you are always the <vServer::teamName0>";
