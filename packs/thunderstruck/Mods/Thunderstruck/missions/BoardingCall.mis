$teamScoreLimit = 8;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 7;
$cdPlayMode = 1;

%group = nameToId("MissionGroup\\MotherShip\\CargoBay\\DropShipDoors");
%count = Group::objectCount(%group);
%door = Group::getObject(%group, 1);
GameBase::setDamageLevel(%door, 999);
%door = Group::getObject(%group, 2);
GameBase::setDamageLevel(%door, 999);
%group = nameToId("MissionGroup\\teams\\team1\\DropShip\\Stations");
%count = Group::objectCount(%group);
%door = Group::getObject(%group, 1);
GameBase::setDamageLevel(%door, 999);
schedule("teamMessages(1, 0, \"Intruder Alert! Intruder Alert!  Dropship Hatch has been blown.\");", 15);

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	if(%this.num == "Main1"){
		%position = "-18.75 58.5 -351";
		%rot = "0 0 6";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main2") {
		%position = "-54.25 58.5 -351";
		%rot = "0 0 6";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%client, %rot);
	} else if(%this.num == "Main3") {
		%position = "-5.25 20 113";
		%rot = "0 0 2.8";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%client, %rot);
	} else if(%this.num == "Main4") {
		%position = "-44.25 19.75 113";
		%rot = "0 0 2.8";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%client, %rot);
	}
}

