//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 3;
$cdPlayMode = 1;

function GroupTrigger::onEnter(%this, %object) {
	if(%this.num == "backhome"){
		%client = Player::getClient(%object);
		%team = Client::getTeam(%client);
		if(%team == 0){
			%position = "8 -8 1995";
		} else {
			%position = "-8 2.5 2249";
		}
		GameBase::setPosition(%client, %position);
		Client::SendMessage(%client,0,"~wshieldhit.wav");
		Client::sendMessage(%client,0,"Try not to fall down again.");
	}
}

