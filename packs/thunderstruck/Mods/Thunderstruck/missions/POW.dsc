$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Halcyon II" @
         "\n<f1>Weather: <f0> Sand Storm" @
         "\n<f1>Time of Day: <f0> Morning" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> prison ship Caged Fury is transporting <vServer::teamName1> prisoners of war and has stopped for refueling and resupply. The <vServer::teamName1> are attempting to free thier comrades while the <vServer::teamName0> are trying to capture more prisoners.\n\n You must nuetralize the enemy by any means neccessary.\n\n The teleporters are on the first floor of each mothership.";
