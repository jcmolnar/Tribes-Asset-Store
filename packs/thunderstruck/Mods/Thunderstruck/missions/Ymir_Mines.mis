$Game::missionType = "D&D";
$cdTrack = 11;
$cdPlayMode = 1;

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	Client::SendMessage(%client,0,"Elevator called; please watch your head.");
}
