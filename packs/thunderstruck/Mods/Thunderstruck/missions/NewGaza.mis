schedule("teamMessages(0, 1, \"Enemy Head Quarters is confirmed at 2.5 kilometers to the North West.\");", 15);
schedule("teamMessages(1, 0, \"A few of you finish placing defenses; the rest of you attack!\");", 21);
schedule("teamMessages(0, 1, \"Several mine fields have been detected on the dunes, be careful.\");", 18);
schedule("teamMessages(1, 1, \"Ship registers All Stop.  All stations to red alert.  Marines attack.\");", 21);

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	%team = Client::getTeam(%client);
	if(%team == 0){
		teamMessages(1, 1, "Intruder Alert! Intruder Alert!");
		teamMessages(1, 1, "~wmine_act.wav");
		Client::SendMessage(%client,0,"~wmine_act.wav");
	}
}
