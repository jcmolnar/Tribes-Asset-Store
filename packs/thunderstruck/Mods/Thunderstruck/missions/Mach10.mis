exec(duelmatch);          
$DuelCountdownSeconds = 18;
$Game::missionType = "DuelTournament";
$cdTrack = 8;
$cdPlayMode = 1;

$mapdelay[1] = 1.2;

function Elevator::onLast(%this) {
	if(%this == $L1)
		%rot = "0 0 0.819389";
	else
		%rot = "0 0 -2.37283";
	GameBase::setRotation(%this.lasthit, %rot);
	Player::applyImpulse(%this.lasthit, "0 0 75");
	%this.lasthit = "";
	%this.status = "down";
	%this.waypoint = "top";
	%this.delayTime = getSimTime();
	Elevator::checkDelay(%this);		
}

function Elevator::onFirst(%this)
{
	%this.status = "up";
	%this.delayTime = getSimTime();
	%this.triggerHit = "";
	if(%this.loop != "")	{
		Elevator::checkDelay(%this);		
	}
}

function Elevator::onCollision(%this, %object) {
	if(!Player::isDead(%object) && getObjectType(%object) == "Player") {
		%this.lasthit = %object;
		if (GameBase::getTeam(%this) == GameBase::getTeam(%object) || %this.noTeam != "" || GameBase::getTeam(%this) == -1) {
			if (GameBase::isActive(%this) && %this.loop == "" && GameBase::isPowered(%this)  && getSimTime() >= %this.delayTime) {
				if(Moveable::getPosition(%this) == 0 && (%this.triggered == "" || %this.delayTime + 1.5 < getSimTime()) && %this.triggerHit == "") { 
					%this.delayTime = getSimTime() + 1.5;
					%this.triggered = 1;
				}
				if( getSimTime() >= %this.delayTime ) { 
					Elevator::trigger(%this);
					return true;
				}
			}
			else if(GameBase::getDataName(%object) == AntipersonelMine) 
				AntipersonelMine::onCollision(%object,%this);
		}
	}
	return false;
}

function Elevator::onWaypoint(%this) {
	%waypoint = Moveable::getPosition(%this);
	if(%waypoint != 0 && %waypoint != Moveable::getWaypointCount(%this)-1) {  
		%this.delayTime = getSimTime() + $mapdelay[%waypoint];
		Elevator::checkDelay(%this);		
	}
}

%group = nameToId("MissionGroup\\L1\\elevator4x4");
%count = Group::objectCount(%group);
$L1 = Group::getObject(%group, 0);
%group = nameToId("MissionGroup\\L2\\elevator4x4");
%count = Group::objectCount(%group);
$L2 = Group::getObject(%group, 0);

function DuelInit(%clientId, %foeId) {
	if(Moveable::getPosition($L1) != 0 || Moveable::getPosition($L2) != 0) {
		schedule("DuelInit(" @ %clientId @ "," @ %foeId @ ");", 3);
		return;
	}

	if (!$DuelSpotTaken[1]) {                                                  
		$DuelSpotIndex[%clientId] = 1;
		$DuelSpotIndex[%foeId] = 1;
		%group = nameToID("MissionGroup/Duel1");
	   	%count = Group::objectCount(%group);
		$DuelSpawnMarker[%clientId] = Group::getObject(%group, 0);
		$DuelSpawnMarker[%foeId] = Group::getObject(%group, 1);
		$DuelSpotTaken[1] = true;
	} else {
		//TODO: take care of this case here
		return;
	}

	%clientId.observerMode = "";
	%foeId.observerMode = "";
	%foeId.observerTarget = "";
	%clientId.observerTarget = "";
	%clientId.guiLock = true;
	%foeId.guiLock = true;
	Client::setGuiMode(%clientId, $GuiModePlay);
	Client::setGuiMode(%foeId, $GuiModePlay);

	$Dueling[%clientId] = %foeId;
	$Dueling[%foeId] = %clientId;

	Game::refreshClientScore(%clientId);	
	Game::refreshClientScore(%foeId);	
	
	%clientPl = DuelSpawn(%clientId);
	%foePl = DuelSpawn(%foeId);                                  
	LockPlayers(%clientId, %foeId, %clientPl, %foePl);

	GameBase::SetTeam(%clientId, 0);
	GameBase::SetTeam(%clientPl, 0);
	GameBase::SetTeam(%foeId, 0);
	GameBase::SetTeam(%foePl, 0);

	for(%cl = Client::getFirst(); %cl != -1; %cl = Client::getNext(%cl)) { 
		if (%cl != %foeId && %cl != %clientId) {
			if(floor(getRandom() * 10) > 5)
				Observer::setTargetClient(%cl, %clientId);
			else
				Observer::setTargetClient(%cl, %foeId);
		}
	}		

	$DuelCanHurt[%clientId] = false;
	$DuelCanHurt[%foeId] = false;               
	DuelCountdown(%clientId, %foeId, $DuelCountdownSeconds, %clientPl, %foePl);
}
