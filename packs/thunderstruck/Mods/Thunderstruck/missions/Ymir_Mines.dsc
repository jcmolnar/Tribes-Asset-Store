$MDESC::Type = "Defend and Destroy";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Defend And Destroy" @
         "\n<f1>Planet: <f0> Ymir" @
         "\n<f1>Weather: <f0> Sunny, Clear" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> has planning a rapid assault on Ymir to destroy the <vServer::teamName1> resource mines, but 2 of the 3 dropships were destroyed by an unexpected naval laser while inbound to the planet. With thier numeric advantage gone and no chance of leaving, the <vServer::teamName0> must attack the mines and disable the naval laser if they hope to leave the planet alive. ";
