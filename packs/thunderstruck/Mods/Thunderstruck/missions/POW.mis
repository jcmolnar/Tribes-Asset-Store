exec(objectives);
$Game::MissionType = "CTF";
$cdTrack = 4;
$cdPlayMode = 1;

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	if(%this.num == "Main1"){
		%position = "30 602 1996.5";
		%rot = "0 0 3.1416";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
		Client::SendMessage(%client,0,"~wshieldhit.wav");
	} else if(%this.num == "Main2") {
		%position = "59 700 52.5";
		%rot = "0 0 2.13";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main3") {
		%position = "61 696 52.5";
		%rot = "0 0 2.13";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main4") {
		%rot = "0 0 4.28";
		%position = "20.5 629 1995";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main5") {
		%position = "68 635.5 3004";
		%rot = "0 0 2.68";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main6") {
		%position = "32.5 659 1004";
		%rot = "0 0 2.88";
		GameBase::setPosition(%client, %position);
		GameBase::setRotation(%object, %rot);
	} else if(%this.num == "Main7") {
