	} else if(%this.num == "Main13") {
		Client::SendMessage(%client,0,"Soldier thawed.  Try to survive longer than your predecessor.");
	} else if(%this.num == "Main14") {
		Client::SendMessage(%client,0,"Soldier thawed.  Try to survive longer than your predecessor.");
	}
