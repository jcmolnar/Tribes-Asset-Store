$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Omicron Argentis VII" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other for control of a great fortress.  The fortress will prove to be crucial as it is equipped with Missile Control Stations, among other weapons.  The first team to capture the flag 6 times shall be the victor!\n\n<f1>Map created by MITTENMAN and [HvC]NaTeDoGG\nFor use only with the HaVoC mod.\nhttp://havoc.sirris.com";
