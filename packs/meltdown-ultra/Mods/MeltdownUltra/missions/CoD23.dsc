$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> EX Centuroph" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other for the rights in the final death match against the EX Tribe! During this mission EX will land to drop off repair packs on the landing pad, this pad is the only spot for repair supplies. Work as a team and destroy your foe so you may have the right to fight the mighty EX!";
