$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Vombaugh IV" @
         "\n<f1>Weather: <f0> Sunny" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> encounter each without warning.  Both Tribes have already established heavy defenses.  Capture the other team's flag 5 times to win the zone and move forward in your development." @
	"\n\<f1>Author: <f0> XGN cLiPPy";