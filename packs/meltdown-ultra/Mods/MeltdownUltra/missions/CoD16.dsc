$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Avicord's Planet" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> are battling for control of five towers.  Each tower contains a switch; touch it to capture it for your team.  " @
         "In addition to the towers each team can capture the others flag for 1 point. The first team with 15 captures/objectives wins.";
