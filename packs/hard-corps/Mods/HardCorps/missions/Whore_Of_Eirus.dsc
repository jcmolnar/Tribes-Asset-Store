$MDESC::Type = "HardCorps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Unfortunate Oversight" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0>The <vServer::teamName0> and <vServer::teamName1> have infiltrated and commandeered each others massive flying bases, loosing their flags in the commotion.  Each team must find the enemy flag carrier, relieve him of the flag, and then touch the enemies flag to it to gain a point. The first team to score four shall be the victor!" @
         "\n\n<f1>HARD CORPS map by:<f0> [SHIT]Warpath";
