$MDESC::Type = "HardCorps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other at close range with their massive flying bases.  Each team must grab the other's flag and successfully bring it back to their base, touch it to their own flag to capture it.  The first team with eight captures shall be the victor!" @
         "\n\n<f1>HARD CORPS map by:<f0> [SHIT]Warpath";
