$teamScoreLimit = 32;
exec(objectives);
exec(fb1vs1mod);
$Game::missionType = "1vs1";
$cdTrack = 9;
$cdPlayMode = 1;

function GroupTrigger::onEnter(%this, %object)
{
%client = Player::getClient(%object);
	if(%this.num == "TP1"){
      %positionIn = "592.479 608.584 102.003";
      %positionOut = "";
   }
      else if(%this.num == "TP2"){
      %positionIn = "592.479 731.916 102.002";
      %positionOut = "";
   }
   else if(%this.num == "TP3"){
      %positionIn = "664.319 731.945 102.003";
      %positionOut = "";
   }
   else if(%this.num == "TP4"){
      %positionIn = "664.319 608.197 102.001";
      %positionOut = "";
   }
   else if(%this.num == "TP5"){
      %positionIn = "736.227 608.008 102.003";
      %positionOut = "";
   }
   else if(%this.num == "TP6"){
      %positionIn = "736.227 732.21 102.001";
      %positionOut = "";
   }
   else if(%this.num == "TP7"){
      %positionIn = "808.067 731.938 102.003";
      %positionOut = "";
   }
   else if(%this.num == "TP8"){
      %positionIn = "808.067 608.219 102.002";
      %positionOut = "";
   }

  	if(%this.in){ 
         GameBase::setPosition(%client, %positionIn);
         //messageAll(0, "~wshieldhit.wav");
	   Client::SendMessage(%client,0,"~wshieldhit.wav");
      }
      	else if(%this.out){
         GameBase::setPosition(%client, %positionOut);
         //messageAll(0, "~wshieldhit.wav");
         Client::SendMessage(%client,0,"~wshieldhit.wav");
	}
 
} 