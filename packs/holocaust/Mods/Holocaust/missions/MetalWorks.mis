$Game::missionType = "DuelTournament";
exec(duelmatch);
MakeFireOne();
MakeFireTwo();
MakeFireThree();
PourFire();

function GroupTrigger::onEnter(%this, %object) {
	if(%this.num == "HotFire") {
		%client = Player::getClient(%object);
		%player = Client::getOwnedObject(%client);
		%position = GameBase::getPosition(%player);
		GameBase::applyDamage(%object, 3, 9, GameBase::getPosition(%player), "0 0 0", "0 0 0", %player);
		Client::onKilled(%client, %client); 
		%PlayerName = Client::getName(%client);
		messageAll(0, %PlayerName @ " is vaporized in a smelter.");
		Player::kill(%player);
		Player::blowUp(%player);
	} else if(%this.num == "HotMetal") {
		%client = Player::getClient(%object);
		%player = Client::getOwnedObject(%client);
		%position = GameBase::getPosition(%player);
		GameBase::applyDamage(%object, 3, 9, GameBase::getPosition(%player), "0 0 0", "0 0 0", %player);
		Client::onKilled(%client, %client); 
		%PlayerName = Client::getName(%client);
		messageAll(0, %PlayerName @ " is melted by molten iron.");
		Player::kill(%player);
		Player::blowUp(%player);
	} else if(%this.num == "Fire") {
		%client = Player::getClient(%object);
		%player = Client::getOwnedObject(%client);
		HaVoC_startBurn(%client, %player, 6);
	}
}