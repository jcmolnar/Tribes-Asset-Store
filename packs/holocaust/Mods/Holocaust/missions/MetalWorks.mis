
function MakeFireOne(){
  %randnumber = floor(getRandom() * 5);
  if(%randnumber == 0) {
    %position = "-21 41 241";
  } else if(%randnumber == 1) {
    %position = "-21 42 241";
  } else if(%randnumber == 2) {
    %position = "-21 40 241";
  } else if(%randnumber == 3) {
    %position = "-20 41 241";
  } else {
    %position = "-22 41 241";
  }
  %object = newObject("","Mine", "Concussion");
  addToSet("MissionCleanup", %object);
  GameBase::StartFadeOut(%object);
  schedule("GameBase::SetPosition(" @ %object @ ", \"" @  %position @ "\");", 1.7);
  schedule("MakeFireOne();", 2);
}

function MakeFireTwo(){
  %randnumber = floor(getRandom() * 5);
  if(%randnumber == 0) {
    %position = "-20.5 -41 228.5";
  } else if(%randnumber == 1) {
    %position = "-22.5 -41 228.5";
  } else if(%randnumber == 2) {
    %position = "-21.5 -41 228.5";
  } else if(%randnumber == 3) {
    %position = "-21.5 -40 228.5";
  } else {
    %position = "-21.5 -42 228.5";
  }
  %object = newObject("","Mine", "Concussion");
  addToSet("MissionCleanup", %object);
  GameBase::StartFadeOut(%object);
  schedule("GameBase::SetPosition(" @ %object @ ", \"" @  %position @ "\");", 1.7);
  schedule("MakeFireTwo();", 2);
}

function MakeFireThree(){
  %randnumber = floor(getRandom() * 5);
  if(%randnumber == 0) {
    %position = "40.5 40.5 227";
  } else if(%randnumber == 1) {
    %position = "40.5 39.5 227";
  } else if(%randnumber == 2) {
    %position = "40.5 41.5 227";
  } else if(%randnumber == 3) {
    %position = "39.5 40.5 227";
  } else {
    %position = "41.5 40.5 227";
  }
  %object = newObject("","Mine", "Concussion");
  addToSet("MissionCleanup", %object);
  GameBase::StartFadeOut(%object);
  schedule("GameBase::SetPosition(" @ %object @ ", \"" @  %position @ "\");", 1.7);
  schedule("MakeFireThree();", 2);
}

function PourFire(){
  %trans = "0.995 0.096 0.0 -0.003 0.035 -1.0 -0.096 0.995 0.034 42.385 36.34 260.73";
  Projectile::spawnProjectile("FlamerBolt", %trans, -1, "0 0 0"); 
  schedule("PourFire();", 1);
}

