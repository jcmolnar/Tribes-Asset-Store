$MDESC::Type = "Capture and Hold";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture and Hold" @
         "\n<f1>Country: <f0> Canada" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> Its winter up in Canada and the <vServer::teamName0> is facing of with the  <vServer::teamName1> for possession of three bunkers.  The bunkers are hidden within the icy spires near each team's outpost.  Each faction must find and control these locations to gain points.  The first faction to reach 300 is the victor!";
