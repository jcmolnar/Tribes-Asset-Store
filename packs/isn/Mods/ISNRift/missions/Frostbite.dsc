$MDESC::Type = "ISN Maps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
        "\n<f1>Planet: <f0> Alpha Horizion - TF Out Post" @
        "\n<f1>Weather: <f0> Sunny, Snowing" @
        "\n<f1>Time of Day: <f0> Midday" @ 
        "\n<f1># of Teams: <f0> 2" @
        "\n\n<f1>Briefing:<f0> Map Created using the in-game TRIBES Editor" @
        "\n          for use with the ISNadmin  TRIBES Mod in association with the clan Twisted Fanatics. This map" @
	"\n          <f1>MAY<f0> be used with unmodified Tribes. Map taken from the mod Insomniax for use with ISNadmin." @
	"\n\n<f2>Author:<f1> Kevin Savage (*IX*Savage1)" @
	"\n<f2>MAP URL:<f1> http://www.insomniax.net" @
              "\n<f2>ISNAdmin MOD URL:<f1> http:/http://twistedfanatics.cyberlot.net/mod/" @
              "\n\n<f2>Mod Author:<f1> Ross Cheetham or (TF)Ryath" @
	"\n\n<f1>Team 0:<f0> The <vServer::teamName0> team has the " @
        "\n       North East Base." @ 
	"\n<f1>Team 1:<f0> The <vServer::teamName1> team has the " @
	"\n       South West Base."; 
