function InitSnowDevilOnceAndNeverCallMeAgain()
{
	%group0 = "MissionGroup/Teams/Secondarybase0";
	%group1 = "MissionGroup/Teams/Secondarybase1";
	// Set Ownership of Secondary Bases to Corresponding Teams. 
	Group::iterateRecursive(%group0, GameBase::setTeam, 0);
	Group::iterateRecursive(%group1, GameBase::setTeam, 1);

	// Set Random Drop Points for Team 0's Secondary Base. 	
	%dropPoints = nameToID(%group0 @ "/DropPoints");
	%oldDropSet = nameToID("MissionCleanup/TeamDrops-1");
	%newDropSet = nameToID("MissionCleanup/TeamDrops0");
	for(%i = 0; (%dropPoint = Group::getObject(%dropPoints, %i)) != -1; %i++)
	{
		if(%oldDropSet != -1)
			removeFromSet(%oldDropSet, %dropPoint);
		addToSet(%newDropSet, %dropPoint);
	}

	// Set Random Drop Points for Team 1's Secondary Base. 
	%dropPoints = nameToID(%group1 @ "/DropPoints");
	%oldDropSet = nameToID("MissionCleanup/TeamDrops-1");
	%newDropSet = nameToID("MissionCleanup/TeamDrops1");
	for(%i = 0; (%dropPoint = Group::getObject(%dropPoints, %i)) != -1; %i++)
	{
		if(%oldDropSet != -1)
			removeFromSet(%oldDropSet, %dropPoint);
		addToSet(%newDropSet, %dropPoint);
	}
}

// NEVER USE THIS FUNCTION.  ONLY ALLOW IT TO RUN HERE TO INIT THE MAP.  
schedule("InitSnowDevilOnceAndNeverCallMeAgain();",5);

//--- export object end ---//
$teamScoreLimit = 10;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 10;
$cdPlayMode = 1;
