$MDESC::Type = "ISN Maps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Zeta Hercules IX" @
         "\n<f1>Weather: <f0> Foggy" @
         "\n<f1>Time of Day: <f0> Morning" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> wage war for control of the derelict mines of Zeta Hercules IX.  Each team must capture the other's flag and successfully bring it back to their base.  The first team with 10 captures shall be the victor!\n\n<f1>HARD CORPS map by:<f0> [SHIT]Warpath";
