$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Alpha Centauri VX" @
         "\n<f1>Weather: <f0> Raining" @
         "\n<f1>Time of Day: <f0> Midday" @
         "\n<f0>The greater the difficulty, the more the glory in surmounting it.Alpha Centauri VX became a legendary battleground due to the rich environment and close proximity to Earth and Mars.Capture the enemy flag for 5 points.20 objectives are needed for a team win." @
         "\n\n<f1>Map By:<f0> UltraVXAuthor<f2> kissie-POO <f4>email:<f2> kissie@speakeasy.org" @
         "\n<f1>UltraVX4MapPack:<f2> http://www.planetstarsiege.com/ultravx";