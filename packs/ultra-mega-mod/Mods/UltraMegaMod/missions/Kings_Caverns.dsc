$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture The Flag" @
         "\n<f1>Place: <f0> Snow Cone" @
         "\n<f1>Weather: <f0> F-en Cold" @
         "\n<f1>Time of Day: <f0> Killen Time" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> Beneath tons of ice and yellow snow the <vServer::teamName1> and <vServer::teamName0> battle each other for control of the famous Kings Caverns. Eight caps of the flags wins the battle. It is said that one of the great kings of Mappers Extreme is barried in one of the great caverns. If you can find his grave then you will also win the game." @
         "\n\n<f1>Map engineered and designed by:<f0> EEPROM (Mappers Extreme)" @
         "\n<f1>Special thanks to:<f0> T. Toton III (Dragon Bones) for his awesome cavern idea." @
         "\n<f1>Home Page:<f0> www.planetstarsiege.com/extreme and www.resistanceimaging.com/pms";

