		instant TeamGroup "team5";
		instant TeamGroup "team6";
		instant TeamGroup "team7";
	};
};
//--- export object end ---//
$Game::missionType = "Duel";
exec(duelmod);

$cdTrack = 8;
$cdPlayMode = 1;

