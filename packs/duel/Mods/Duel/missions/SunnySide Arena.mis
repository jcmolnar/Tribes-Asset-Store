// 1.50 PORT: this was the only "Duel" map in the package that never exec'd duelmod --
// it exec'd arena.cs instead, and no arena.cs exists in the upstream export (checked
// every loose file and all 141 .vol archives). Without it the map loaded under plain
// base objectives. exec(duelmod) is what the other 158 duel maps do.
exec(duelmod);
$cdTrack = 4;
$cdPlayMode = 1;
