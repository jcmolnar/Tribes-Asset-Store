//--- export object end ---//
$teamScoreLimit = 2;
exec(objectives);
$Game::missionType = "C&H";
$cdTrack = 11;
$cdPlayMode = 1;
//Blow the doors to the tomb
%group = nameToId("MissionGroup\\Tomb1\\Door");
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 2);
GameBase::setDamageLevel(%item, 999);
%item = Group::getObject(%group, 1);
GameBase::setDamageLevel(%item, 999);
%group = nameToId("MissionGroup\\Tomb2\\Door");
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 2);
GameBase::setDamageLevel(%item, 999);
%item = Group::getObject(%group, 1);
GameBase::setDamageLevel(%item, 999);
//Link the missile command pieces
%group = nameToId("MissionGroup\\teams\\team0\\MissileCommand");
%count = Group::objectCount(%group);
%c1 = Group::getObject(%group, 0);
%m1 = Group::getObject(%group, 1);
%m1.comstation = %c1;
%c1.comstation = %m1;
%group = nameToId("MissionGroup\\teams\\team1\\MissileCommand");
%count = Group::objectCount(%group);
%c2 = Group::getObject(%group, 0);
%m2 = Group::getObject(%group, 1);
%m2.comstation = %c2;
%c2.comstation = %m2;
MakeFire();
//Pick the flag that is real
%randnumber = floor(getRandom() * 2);
%group = nameToId("MissionGroup\\teams\\team0\\flags\\flag" @ %randnumber);
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 1);
deleteObject(%item);
%group = nameToId("MissionGroup\\teams\\team0\\flags\\flag" @ %randnumber);
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 0);
deleteObject(%item);
%randnumber = floor(getRandom() * 2);
%group = nameToId("MissionGroup\\teams\\team1\\flags\\flag" @ %randnumber);
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 1);
deleteObject(%item);
%group = nameToId("MissionGroup\\teams\\team1\\flags\\flag" @ %randnumber);
%count = Group::objectCount(%group);
%item = Group::getObject(%group, 0);
deleteObject(%item);
//Notify Players of what is going on
schedule("teamMessages(0, 1, \"The object of this map is to make it to the end\");", 20);
schedule("teamMessages(1, 1, \"The gravity is high so be sure to buy a grapple\");", 20);
schedule("teamMessages(0, 1, \"Find your way through this challenge that leads down into the ground.\");", 26);
schedule("teamMessages(1, 1, \"There are many ways to get trapped or killed in this challenge. \");", 26);
schedule("teamMessages(0, 1, \"There is a switch that you must hit to win the game\");", 32);
schedule("teamMessages(1, 1, \"Its well hidden and you must complete the course if you are to reach it.  Good Luck\");", 32);
schedule("teamMessages(0, 0, \"The object of this map is to make it to the end\");", 20);
schedule("teamMessages(1, 0, \"The gravity is high so be sure to buy a grapple\");", 20);
schedule("teamMessages(0, 0, \"Find your way through this challenge that leads down into the ground.\");", 26);
schedule("teamMessages(1, 0, \"There are many ways to get trapped or killed in this challenge. \");", 26);
schedule("teamMessages(0, 0, \"There is a switch that you must hit to win the game\");", 32);
schedule("teamMessages(1, 0, \"Its well hidden and you must complete the course if you are to reach it.  Good Luck\");", 32);

function GroupTrigger::onEnter(%this, %object) {
	%client = Player::getClient(%object);
	%player = Client::getOwnedObject(%client);
	if(%this.num == "1"){
		if(floor(getRandom() * 2) == 1) {
			%pos = GameBase::getPosition(%this);
			playSound(Ricochet3, %pos);
			if(%player.shieldStrength <= 0) {
				Client::SendMessage(%client,2,"You have been hit with a poison tipped dart.");
				HaVoC_startBlind(%client, %player, 4);
			} else {

				Client::SendMessage(%client,0,"Something hit your shields.");
				%energy = GameBase::getEnergy(%player);
				GameBase::SetEnergy(%player, %energy - 25);
				if(%this.lastsound < getSimTime()) {
					playSound(SoundShldOn, GameBase::getPosition(%this));
					%this.lastsound = getSimTime() + 1;
				}
			}
		}
	} else if(%this.num == "2") {
		HaVoC_startBlind(%client, %player, 6);
	} else if(%this.num == "3") {
		if(%player.shieldStrength <= 0) {
			HaVoC_startBurn(%client, %player, 4);
		} else {
			if(%this.lastsound < getSimTime()) {
				playSound(SoundShldOn, GameBase::getPosition(%this));
				%this.lastsound = getSimTime() + 1;
			}
			%energy = GameBase::getEnergy(%player);
			GameBase::SetEnergy(%player, %energy - 25);
		}		
	} else if(%this.num == "4") {
		GameBase::setDamageLevel(%player, 999);
		Player::blowUp(%player);
		%PlayerName = Client::getName(%client);
		messageall(0, %PlayerName @ " needs to fly, in the sight of the eagle's eye");
	} else if(%this.num == "5") {
		if(Player::getMountedItem(%player,$FlagSlot) == "flag") {
			%randnumber = floor(getRandom() * 5);
			if(%randnumber == 1) {
				%drrate = GameBase::getDamageLevel(%player) + 0.25;
			} else if(%randnumber >= 4) {
				%drrate = GameBase::getDamageLevel(%player) + 0.12;
			} else {
				%drrate = GameBase::getDamageLevel(%player) + 0.05;
			}
			%flag = %player.carryFlag;
			%flagTeam = GameBase::getTeam(%flag);
			GameBase::throw(%flag, %player, -12, false);
			Item::hide(%flag, false);
			Player::setItemCount(%player, "Flag", 0);
			%flag.carrier = -1;
			$playerHas[%playerTeam] = "";
			%player.carryFlag = "";
			Flag::clearWaypoint(%playerClient, false);
			GameBase::setDamageLevel(%player, %drrate);
			pokeEm(%client, %player);
			if(Player::isDead(%player) == "True") {
				%PlayerName = Client::getName(%client);
				messageall(0, %PlayerName @ " is struck dead by an unknown force.");
			} else {
				Client::SendMessage(%client, 2,"A jolt of energy knocks the flag out of your grasp.");
			}
		}
	} else if(%this.num == "6") {
		if(Player::getMountedItem(%player,$FlagSlot) == "flag") {
			%randnumber = floor(getRandom() * 5);
			if(%randnumber == 1) {
				%drrate = GameBase::getDamageLevel(%player) + 0.12;
			} else {
				%drrate = GameBase::getDamageLevel(%player) + 1;
			}
			%flag = %player.carryFlag;
			%flagTeam = GameBase::getTeam(%flag);
			GameBase::throw(%flag, %player, -12, false);
			Item::hide(%flag, false);
			Player::setItemCount(%player, "Flag", 0);
			%flag.carrier = -1;
			$playerHas[%playerTeam] = "";
			%player.carryFlag = "";
			Flag::clearWaypoint(%playerClient, false);
			GameBase::setDamageLevel(%player, %drrate);
			pokeEm(%client, %player);
			if(Player::isDead(%player) == "True") {
				%PlayerName = Client::getName(%client);
				messageall(0, %PlayerName @ " is struck dead by an unknown force.");
			} else {
				Client::SendMessage(%client, 2,"A jolt of energy knocks the flag out of your grasp.");
			}
		}
	} else if(%this.num == "7") {
		if(%player.shieldStrength <= 0) {
			%drrate = GameBase::getDamageLevel(%player) + 0.2;
			GameBase::setDamageLevel(%player, %drrate);
			HaVoC_startBurn(%client, %player, 4);
		} else {
			if(%this.lastsound < getSimTime()) {
				playSound(SoundShldOn, GameBase::getPosition(%this));
				%this.lastsound = getSimTime() + 1;
			}
			%energy = GameBase::getEnergy(%player);
			GameBase::SetEnergy(%player, %energy - 45);
			%drrate = GameBase::getDamageLevel(%player) + 0.02;
			GameBase::setDamageLevel(%player, %drrate);
		}
		%pos = GameBase::getPosition(%this);
		playSound (SoundFireSeeking, %pos);
		%jumpDir = Vector::getFromRot("1.57 0 0", 725, 0);
		Player::applyImpulse(%object,%jumpDir);
		if(Player::isDead(%player) == "True") {
			%PlayerName = Client::getName(%client);
			messageall(0, %PlayerName @ " is roasted on a hot spring.");
		}
	} else if(%this.num == "8") {
		if(GameBase::isPowered(%this) == "True") {
			GameBase::setDamageLevel(%player, 999);
			Player::blowUp(%player);
			%PlayerName = Client::getName(%client);
			messageall(0, %PlayerName @ " is electricuted.");
		}
	} else if(%this.num == "9") {
		if(%player.shieldStrength <= 0) {
			%drrate = GameBase::getDamageLevel(%player) + 0.8;
			GameBase::setDamageLevel(%player, %drrate);
			HaVoC_startBurn(%client, %player, 6);			
		} else {
			if(%this.lastsound < getSimTime()) {
				playSound(SoundShldOn, GameBase::getPosition(%this));
				%this.lastsound = getSimTime() + 1;
			}
			GameBase::SetEnergy(%player, 0);
			%drrate = GameBase::getDamageLevel(%player) + 0.35;
			GameBase::setDamageLevel(%player, %drrate);
			HaVoC_startBurn(%client, %player, 2);
		}		
		if(Player::isDead(%player) == "True") {
			%PlayerName = Client::getName(%client);
			messageall(0, %PlayerName @ " is stuck out to dry on pungy sticks.");
		}
	} else if(%this.num == "10") {
		Client::SendMessage(%client, 1,"YOU HAVE ANGERED THE SPIRIT OF THE TOMB!");
		schedule("SealDoorTwo();", 7);
		StartHellTwo();
	} else if(%this.num == "11") {
		Client::SendMessage(%client, 1,"YOU HAVE ANGERED THE SPIRIT OF THE TOMB!");
		schedule("SealDoorOne();", 7);
		StartHellOne();
	} else if(%this.num == "12") {
		%randnumber = floor(getRandom() * 8);
		if(%randnumber == 1) {
			if(%player.shieldStrength <= 0) {
				%drrate = GameBase::getDamageLevel(%player) + 0.75;
				GameBase::setDamageLevel(%player, %drrate);
				if(Player::isDead(%player) == "True") {
					%PlayerName = Client::getName(%client);
					messageall(0, %PlayerName @ " is impaled by a large spear.");
				} else {
					Client::SendMessage(%client,0,"You are hit by a spear.");
				}
			} else {
				if(%this.lastsound < getSimTime()) {
					playSound(SoundShldOn, GameBase::getPosition(%this));
					%this.lastsound = getSimTime() + 1;
				}
				GameBase::SetEnergy(%player, 0);
				Client::SendMessage(%client,0,"Your shield deflect a spear.");
			}		
		}
	}
}
function SealDoorOne() {
	%obj = newObject("", "StaticShape", "ForceField");
      addToSet("MissionCleanup", %obj);
	%rot = "0 0 1.57";
	GameBase::setRotation(%obj, %rot); 
	%doorposition = "671 692 94";
	GameBase::SetPosition(%obj, %doorposition);
	schedule("UnSealDoor(" @ %obj @");", 30);
}

function SealDoorTwo() {
	%obj = newObject("", "StaticShape", "ForceField");
      addToSet("MissionCleanup", %obj);
	%rot = "0 0 1.57";
	GameBase::setRotation(%obj, %rot); 
	%doorposition = "-267.75 -874 34.5";
	GameBase::SetPosition(%obj, %doorposition);
	schedule("UnSealDoor(" @ %obj @");", 30);
}

function UnSealDoor(%item)  {
	GameBase::startFadeOut(%item);
	schedule("deleteObject(" @ %item @ ");",2.5, %item);
}

function MakeFlagGrenadeOne(%grenadetype) {
	%randnumber = floor(getRandom() * 20);
	if(%randnumber == 1) {
		%grenadeposition = "-35 190 -20";
	} else if(%randnumber == 2) {
		%grenadeposition = "-30 209 -20";
	} else if(%randnumber == 3) {
		%grenadeposition = "-43 209 -20";
	} else if(%randnumber == 4) {
		%grenadeposition = "-36 225 -20";
	} else if(%randnumber == 5) {
		%grenadeposition = "-52 225 -20";
	} else if(%randnumber == 6) {
		%grenadeposition = "-36 226 -20";
	} else if(%randnumber == 7) {
		%grenadeposition = "-52 242 -20";
	} else if(%randnumber == 8) {
		%grenadeposition = "-52 242 20";
	} else if(%randnumber == 9) {
		%grenadeposition = "-35 242 -20";
	} else if(%randnumber == 10) {
		%grenadeposition = "-54 207 -20";
	} else if(%randnumber == 11) {
		%grenadeposition = "-31 222 -20";
	} else if(%randnumber == 12) {
		%grenadeposition = "-35 218 -20";
	} else if(%randnumber == 13) {
		%grenadeposition = "-48 233 -20";
	} else if(%randnumber == 14) {
		%grenadeposition = "-50 225 -20";
	} else if(%randnumber == 15) {
		%grenadeposition = "-38 227 -20";
	} else if(%randnumber == 16) {
		%grenadeposition = "-37 225 -20";
	} else {
		%grenadeposition = "-37 228 -20";
	}
	%object = newObject("","Mine",%grenadetype);
	addToSet("MissionCleanup", %object);
	GameBase::SetPosition(%object, %grenadeposition);
}

