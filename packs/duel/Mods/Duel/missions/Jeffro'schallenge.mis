function MakeFire(){
	%randnumber = floor(getRandom() * 3);
	if(%randnumber == 0) {
		%grenadeposition = "16 -48 75";
	} else if(%randnumber == 1) {
		%grenadeposition = "32 -63.5 84";
	} else if(%randnumber == 2) {
		%grenadeposition = "25 -56.5 83";
	}
	%object = newObject("","Mine", "Concussion");
	GameBase::StartFadeOut(%object);
	addToSet("MissionCleanup", %object);
	schedule("GameBase::SetPosition(" @ %object @ ", \"" @  %grenadeposition @ "\");", 1.7);
	schedule("MakeFire();", 10);
}
