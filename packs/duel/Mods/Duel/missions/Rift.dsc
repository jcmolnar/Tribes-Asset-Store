$MDESC::Type = "Tribes Arena";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Arena" @
	 "\n<f1>Planet: <f0> Dimensional Rift" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> have been caught in a rift that has taken them into some dimension unfamiliar to them.  The apparent source of this anomaly is a generator of some kind.  Only one tribe will leave this place today." @
