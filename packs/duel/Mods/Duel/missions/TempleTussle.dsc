$MDESC::Type = "Tribes Arena";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Tribes Arena" @
         "\n<f1>Planet: <f0> Septa Scarabae IV" @
         "\n<f1>Weather: <f0> Foggy" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> On the remote planet of Septa Scarabae IV lies the tomb of KingElmoeaireeaTuT, a legendary warrior.  The Diamond Sword stumble upon the tomb, only to find that the Blood Eagle have beaten them to it.  Suddenly the enterance to the tomb collapses, leaving both tribes trapped in the legendary tomb.  Do put the tomb to good use by burying your opponents for good." @
         "\n\n<jc><f1>E<f2>L<f0>M<f1>0 <f1>D<f2>E<f0>S<f1>I<f2>G<f0>N<f1>S" @
	   "\n\n<f1>Map By: <f0>TF_FlyingElmo aka <f2>[-s7sLicK-]" @
	   "\n<f1>Email: <f0>flyingelmo@teamfusion.org" @
	   "\n<f0>www.<f1>tribalwar.<f0>com/<f1>elmo" @
         "\n<f1>www.<f0>tribesarena.<f1>net";
