$MDESC::Type = "Tribes Racer";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TribesRacer" @
         "\n<f1>Planet: <f0> Deus Sanguinius" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 1" @
         "\n\n<f1>Briefing:<f0> The racing track on Deus Sanguinius has just opened!\nYou have to complete 10 rounds with the Scout and \nkeep your opponents from doing the same!\n\nIf you kill someone, you gain a round. If you get killed, you loose a round." @
         "\n\n\n\n\n Created by: Josef Jahn," @
	   " creator of SPOONBOT. Visit http://www.playspoon.com and download more cool Tribs stuff!";
