      "paths": [
        "Mods\\SWRPG"
      ],
      "launchMods": [
        "SWRPG"
      ]
    },
    {
      "id": "starwars",
      "title": "Star Wars TC 2.0 (full)",
      "category": "mods",
      "description": "The complete Star Wars total conversion: eight Star Wars maps (Dantooine, Tatooine, Battle of Hoth, Yavin Base, Mos Eisley, Mos Espa, Sarlaac Pit, Sith Knight), custom vehicles, weapons, sounds and voices. Every texture AI-upscaled 4x and palettized, legacy .vol archives converted to .zip, and deduplicated against base Tribes so you download the mod rather than another copy of the game. Launch with -mod StarWars.",
      "author": "Star Wars TC team",
      "version": 7,
      "state": "live",
      "paths": [
        "Mods\\StarWars"
      ],
      "launchMods": [
        "StarWars"
      ]
    },
    {
      "id": "annihilation",
      "title": "Annihilation",
      "category": "mods",
      "description": "Annihilation - the classic Tribes total conversion, both halves in one download: deployable turrets, jump pads, blast walls and force fields, twelve turret types, tanks and dropships, duels and arena modes, its own bots and admin suite, plus 643 missions, the community skin set and its HUDs. Host it or join with it. Launch with -mod TotalAnnihilation or use the toggle below.",
      "author": "Annihilation team",
      "version": 5,
      "state": "live",
