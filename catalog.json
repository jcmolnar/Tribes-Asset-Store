{
  "_comment": "Asset Store catalog. Each pack's content lives under packs/<id>/ mirroring INSTALL-RELATIVE paths (e.g. packs/tac/Mods/Tac/scripts.vol installs to <game>/Mods/Tac/scripts.vol). tools/publish-store.ps1 in the native repo validates this file, hashes the content, regenerates store.json, and commits. Adding an asset never touches the game manifest or bumps the game version.",
  "packs": [
    {
      "id": "tac",
      "title": "Tribes Aerial Combat (TAC) 1.41",
      "category": "mods",
      "description": "Team Aerial Combat - teamwork-required flight combat by the TPG team (2001). Full client and server: 29 missions (CTF, C&H, TDM, D&D, F&R), custom skins and sounds, and the complete server-side scripts so you can host it. Launch with -mod Tac or use the toggle below.",
      "author": "TAC Development Team",
      "version": 5,
      "state": "live",
      "paths": [
        "Mods\\Tac"
      ],
      "launchMods": [
        "Tac"
      ]
    },
    {
      "id": "rmrpg",
      "title": "Red Moon RPG (RMRPG)",
      "category": "mods",
      "description": "Red Moon RPG - the Tribes RPG variant that stacks on top of the base RPG mod: its own missions, skins, GUI and server scripts. Needed to join Red Moon servers. Launch with -mod rpg -mod rmrpg (RMRPG stacks on RPG) or use the toggle below.",
      "author": "Red Moon RPG team",
      "version": 7,
      "state": "live",
      "paths": [
        "Mods\\RMRPG"
