    {
      "id": "gpu-normals",
      "title": "HD Normal Maps -- Full Coverage",
      "category": "assets",
      "description": "5,756 additional normal maps that fill the gaps the per-terrain-pack sets leave. The HD terrain packs each carry normal maps for their own tiles, but most of the game's other surfaces -- base interiors, mod art, skins, effects -- had none, so bump lighting simply did not apply to them. This pack completes the coverage, so surfaces light with real depth everywhere instead of only on packaged terrain. Needs $pref::gpuNormalMap on (it is on by default). Purely visual: no gameplay change, no mod to select, and nothing depends on it.",
      "author": "Generated for Modern Tribes with DeepBump",
      "version": 1,
      "state": "live",
      "launchMods": [],
      "preview": "",
